# Patch 02: 拡張機能ツールバーの生成をタブレット限定にしない
# ToolbarManager は Patch 01 の ViewStub を見つけると ExtensionsToolbarCoordinator を
# 作るが、その引数に (ToolbarTablet) mToolbarLayout とキャストして渡していた。
# スマホでは mToolbarLayout が ToolbarPhone なので ClassCastException になる。
#
# 受け側 (ExtensionsToolbarCoordinator#maybeCreate) の引数は ViewGroup rootView で、
# タブレット固有の型を要求していない。キャストを外して素直に渡す。
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
index d2a0603..129b6ba 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
@@ -2687,7 +2687,13 @@ public class ToolbarManager
                                                         mActivityTabProvider.asObservable(),
                                                         mTabCreatorManager.getTabCreator(false),
                                                         getBrowsingModeThemeColorProvider(),
-                                                        (ToolbarTablet) mToolbarLayout,
+                                                        // mobile-bex: 上流はここで ToolbarTablet に
+                                                        // 絞っているが、受け側の引数は
+                                                        // ViewGroup rootView なので、スマホの
+                                                        // ToolbarPhone でもそのまま渡せる。
+                                                        // 渡さないと拡張機能のアイコンが
+                                                        // スマホのツールバーに出ない。
+                                                        mToolbarLayout,
                                                         contextMenuPopulatorFactory,
                                                         selectionDropdownMenuDelegate,
                                                         mTabModelSelector,
