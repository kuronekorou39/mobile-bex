diff --git a/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc b/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc
new file mode 100644
index 0000000..37d60f1
--- /dev/null
+++ b/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc
@@ -0,0 +1,223 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Stub implementation of the sidePanel API for desktop-android.
+// Most functions are no-op or return sensible defaults.
+// open() and close() call through JNI to show/hide a right-slide overlay.
+
+#include "chrome/browser/extensions/api/side_panel/side_panel_api.h"
+
+#include <map>
+#include <optional>
+#include <string>
+#include <tuple>
+
+#include "base/no_destructor.h"
+#include "build/build_config.h"
+#include "chrome/common/extensions/api/side_panel.h"
+#include "chrome/common/extensions/api/side_panel/side_panel_info.h"
+#include "extensions/common/extension.h"
+
+#if BUILDFLAG(IS_ANDROID)
+#include "base/android/jni_string.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "content/public/browser/web_contents.h"
+#include "chrome/browser/ui/android/extensions/jni_headers/ExtensionSidePanelBridge_jni.h"
+#endif
+
+namespace extensions {
+
+namespace {
+
+// setOptions() の内容をセッション内で保持する簡易ストア。
+// 本家 (SidePanelService) 同様に永続化はしない。tab_id == -1 はデフォルト
+// (タブ非依存) 設定。BrowserContext はポインタ値でしか使わないため、
+// プロファイル破棄後に stale エントリが残るが参照されることはない。
+struct StoredPanelOptions {
+  std::optional<std::string> path;
+  std::optional<bool> enabled;
+};
+
+using OptionsKey = std::tuple<const void*, std::string, int>;
+
+std::map<OptionsKey, StoredPanelOptions>& GetOptionsStore() {
+  static base::NoDestructor<std::map<OptionsKey, StoredPanelOptions>> store;
+  return *store;
+}
+
+const StoredPanelOptions* FindStoredOptions(const void* browser_context,
+                                            const std::string& extension_id,
+                                            int tab_id) {
+  auto& store = GetOptionsStore();
+  auto it = store.find({browser_context, extension_id, tab_id});
+  return it != store.end() ? &it->second : nullptr;
+}
+
+}  // namespace
+
+SidePanelApiFunction::SidePanelApiFunction() = default;
+SidePanelApiFunction::~SidePanelApiFunction() = default;
+
+SidePanelService* SidePanelApiFunction::GetService() {
+  return nullptr;
+}
+
+ExtensionFunction::ResponseAction SidePanelApiFunction::Run() {
+  return RunFunction();
+}
+
+// setOptions -> インメモリストアに保存 (open() が参照する)
+ExtensionFunction::ResponseAction SidePanelSetOptionsFunction::RunFunction() {
+  auto params = api::side_panel::SetOptions::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error("Invalid parameters"));
+  }
+  if (extension()) {
+    const int tab_id =
+        params->options.tab_id ? *params->options.tab_id : -1;
+    StoredPanelOptions& stored =
+        GetOptionsStore()[{browser_context(), extension()->id(), tab_id}];
+    if (params->options.path) {
+      stored.path = *params->options.path;
+    }
+    if (params->options.enabled) {
+      stored.enabled = *params->options.enabled;
+    }
+  }
+  return RespondNow(NoArguments());
+}
+
+// getOptions -> ストアから解決 (タブ固有 → デフォルトの順)
+ExtensionFunction::ResponseAction SidePanelGetOptionsFunction::RunFunction() {
+  auto params = api::side_panel::GetOptions::Params::Create(args());
+  api::side_panel::PanelOptions options;
+  options.enabled = true;
+
+  if (extension()) {
+    const StoredPanelOptions* tab_opts = nullptr;
+    if (params && params->options.tab_id) {
+      options.tab_id = *params->options.tab_id;
+      tab_opts = FindStoredOptions(browser_context(), extension()->id(),
+                                   *params->options.tab_id);
+    }
+    const StoredPanelOptions* default_opts =
+        FindStoredOptions(browser_context(), extension()->id(), -1);
+
+    if (tab_opts && tab_opts->enabled) {
+      options.enabled = *tab_opts->enabled;
+    } else if (default_opts && default_opts->enabled) {
+      options.enabled = *default_opts->enabled;
+    }
+
+    if (tab_opts && tab_opts->path) {
+      options.path = *tab_opts->path;
+    } else if (default_opts && default_opts->path) {
+      options.path = *default_opts->path;
+    } else if (SidePanelInfo::HasSidePanel(extension())) {
+      options.path = SidePanelInfo::GetDefaultPath(extension());
+    }
+  }
+  return RespondNow(WithArguments(options.ToValue()));
+}
+
+// setPanelBehavior -> no-op
+ExtensionFunction::ResponseAction
+SidePanelSetPanelBehaviorFunction::RunFunction() {
+  return RespondNow(NoArguments());
+}
+
+// getPanelBehavior -> default (openPanelOnActionClick: false)
+ExtensionFunction::ResponseAction
+SidePanelGetPanelBehaviorFunction::RunFunction() {
+  api::side_panel::PanelBehavior behavior;
+  behavior.open_panel_on_action_click = false;
+  return RespondNow(WithArguments(behavior.ToValue()));
+}
+
+// open -> show right-slide overlay via JNI
+// Supports calls from both popup context and service worker context.
+// When called from a service worker (e.g., via action.onClicked handler),
+// GetSenderWebContents() returns null, so we resolve the tab's WebContents
+// from the tabId parameter instead.
+ExtensionFunction::ResponseAction SidePanelOpenFunction::RunFunction() {
+#if BUILDFLAG(IS_ANDROID)
+  const Extension* ext = extension();
+  if (!ext) {
+    return RespondNow(NoArguments());
+  }
+
+  content::WebContents* web_contents = nullptr;
+
+  // Try to get WebContents from the tabId argument first.
+  // This is critical for service worker calls where GetSenderWebContents()
+  // returns null.
+  auto params = api::side_panel::Open::Params::Create(args());
+  if (params && params->options.tab_id) {
+    ExtensionTabUtil::GetTabById(
+        *params->options.tab_id,
+        browser_context(),
+        include_incognito_information(),
+        &web_contents);
+  }
+
+  // Fall back to sender WebContents (works for popup context).
+  if (!web_contents) {
+    web_contents = GetSenderWebContents();
+  }
+
+  if (web_contents) {
+    // setOptions() の内容を解決する: タブ固有 → デフォルト → manifest の順。
+    int tab_id = params && params->options.tab_id ? *params->options.tab_id
+                                                  : ExtensionTabUtil::GetTabId(web_contents);
+    const StoredPanelOptions* tab_opts =
+        FindStoredOptions(browser_context(), ext->id(), tab_id);
+    const StoredPanelOptions* default_opts =
+        FindStoredOptions(browser_context(), ext->id(), -1);
+
+    // enabled: false が明示されているパネルは開かない。
+    std::optional<bool> enabled;
+    if (tab_opts && tab_opts->enabled) {
+      enabled = *tab_opts->enabled;
+    } else if (default_opts && default_opts->enabled) {
+      enabled = *default_opts->enabled;
+    }
+    if (enabled.has_value() && !*enabled) {
+      return RespondNow(NoArguments());
+    }
+
+    std::optional<std::string> path;
+    if (tab_opts && tab_opts->path) {
+      path = *tab_opts->path;
+    } else if (default_opts && default_opts->path) {
+      path = *default_opts->path;
+    } else if (SidePanelInfo::HasSidePanel(ext)) {
+      path = SidePanelInfo::GetDefaultPath(ext);
+    }
+
+    if (path) {
+      GURL url = ext->GetResourceURL(*path);
+      Java_ExtensionSidePanelBridge_showSidePanel(
+          base::android::AttachCurrentThread(), url.spec(), web_contents);
+    }
+  }
+#endif
+  return RespondNow(NoArguments());
+}
+
+// getLayout -> default
+ExtensionFunction::ResponseAction SidePanelGetLayoutFunction::RunFunction() {
+  api::side_panel::PanelLayout layout;
+  return RespondNow(WithArguments(layout.ToValue()));
+}
+
+// close -> hide overlay via JNI
+ExtensionFunction::ResponseAction SidePanelCloseFunction::RunFunction() {
+#if BUILDFLAG(IS_ANDROID)
+  Java_ExtensionSidePanelBridge_closeSidePanel(
+      base::android::AttachCurrentThread());
+#endif
+  return RespondNow(NoArguments());
+}
+
+}  // namespace extensions
