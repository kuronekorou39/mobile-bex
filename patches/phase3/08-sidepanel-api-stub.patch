diff --git a/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc b/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc
new file mode 100644
index 0000000000..483f5cc25d
--- /dev/null
+++ b/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc
@@ -0,0 +1,69 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Stub implementation of the sidePanel API for desktop-android.
+// All functions are no-op or return sensible defaults.
+// The real implementation (side_panel_api.cc) depends on SidePanelService
+// which requires desktop browser_ui and is not available on Android.
+
+#include "chrome/browser/extensions/api/side_panel/side_panel_api.h"
+
+#include "chrome/common/extensions/api/side_panel.h"
+
+namespace extensions {
+
+SidePanelApiFunction::SidePanelApiFunction() = default;
+SidePanelApiFunction::~SidePanelApiFunction() = default;
+
+SidePanelService* SidePanelApiFunction::GetService() {
+  return nullptr;
+}
+
+ExtensionFunction::ResponseAction SidePanelApiFunction::Run() {
+  return RunFunction();
+}
+
+// setOptions -> no-op
+ExtensionFunction::ResponseAction SidePanelSetOptionsFunction::RunFunction() {
+  return RespondNow(NoArguments());
+}
+
+// getOptions -> default (enabled: true)
+ExtensionFunction::ResponseAction SidePanelGetOptionsFunction::RunFunction() {
+  api::side_panel::PanelOptions options;
+  options.enabled = true;
+  return RespondNow(WithArguments(options.ToValue()));
+}
+
+// setPanelBehavior -> no-op
+ExtensionFunction::ResponseAction
+SidePanelSetPanelBehaviorFunction::RunFunction() {
+  return RespondNow(NoArguments());
+}
+
+// getPanelBehavior -> default (openPanelOnActionClick: false)
+ExtensionFunction::ResponseAction
+SidePanelGetPanelBehaviorFunction::RunFunction() {
+  api::side_panel::PanelBehavior behavior;
+  behavior.open_panel_on_action_click = false;
+  return RespondNow(WithArguments(behavior.ToValue()));
+}
+
+// open -> no-op (could open as tab in the future)
+ExtensionFunction::ResponseAction SidePanelOpenFunction::RunFunction() {
+  return RespondNow(NoArguments());
+}
+
+// getLayout -> default
+ExtensionFunction::ResponseAction SidePanelGetLayoutFunction::RunFunction() {
+  api::side_panel::PanelLayout layout;
+  return RespondNow(WithArguments(layout.ToValue()));
+}
+
+// close -> no-op
+ExtensionFunction::ResponseAction SidePanelCloseFunction::RunFunction() {
+  return RespondNow(NoArguments());
+}
+
+}  // namespace extensions
