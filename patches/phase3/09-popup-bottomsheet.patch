+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.extensions;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.view.View;
+import android.widget.FrameLayout;
+
+import androidx.annotation.StringRes;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.ui.extensions.R;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetContent;
+import org.chromium.components.thinwebview.ThinWebView;
+
+/**
+ * {@link BottomSheetContent} implementation that displays an extension popup
+ * inside a BottomSheet. Wraps a {@link ThinWebView} in a {@link FrameLayout}.
+ */
+@NullMarked
+public class ExtensionBottomSheetContent implements BottomSheetContent {
+    private static final float FULL_HEIGHT_RATIO = 0.7f;
+    private static final float HALF_HEIGHT_RATIO = 0.5f;
+
+    private final FrameLayout mContentView;
+    private final ThinWebView mThinWebView;
+    private final Runnable mOnBackPressedOrDismissed;
+
+    public ExtensionBottomSheetContent(
+            Context context,
+            ThinWebView thinWebView,
+            Runnable onBackPressedOrDismissed) {
+        mThinWebView = thinWebView;
+        mOnBackPressedOrDismissed = onBackPressedOrDismissed;
+
+        mContentView = new FrameLayout(context);
+        mContentView.setBackgroundColor(Color.BLACK);
+        mContentView.addView(
+                mThinWebView.getView(),
+                new FrameLayout.LayoutParams(
+                        FrameLayout.LayoutParams.MATCH_PARENT,
+                        FrameLayout.LayoutParams.MATCH_PARENT));
+    }
+
+    @Override
+    public View getContentView() {
+        return mContentView;
+    }
+
+    @Override
+    public @Nullable View getToolbarView() {
+        return null;
+    }
+
+    @Override
+    public int getVerticalScrollOffset() {
+        return 0;
+    }
+
+    @Override
+    public void destroy() {
+        mThinWebView.destroy();
+    }
+
+    @Override
+    public @ContentPriority int getPriority() {
+        return ContentPriority.HIGH;
+    }
+
+    @Override
+    public boolean swipeToDismissEnabled() {
+        return true;
+    }
+
+    @Override
+    public float getFullHeightRatio() {
+        return FULL_HEIGHT_RATIO;
+    }
+
+    @Override
+    public float getHalfHeightRatio() {
+        return HALF_HEIGHT_RATIO;
+    }
+
+    @Override
+    public boolean hasCustomLifecycle() {
+        return true;
+    }
+
+    @Override
+    public boolean handleBackPress() {
+        mOnBackPressedOrDismissed.run();
+        return true;
+    }
+
+    @Override
+    public @Nullable String getSheetContentDescription(Context context) {
+        return "Extension popup";
+    }
+
+    @Override
+    public @StringRes int getSheetHalfHeightAccessibilityStringId() {
+        return R.string.extension_popup_sheet_opened_half;
+    }
+
+    @Override
+    public @StringRes int getSheetFullHeightAccessibilityStringId() {
+        return R.string.extension_popup_sheet_opened_full;
+    }
+
+    @Override
+    public @StringRes int getSheetClosedAccessibilityStringId() {
+        return R.string.extension_popup_sheet_closed;
+    }
+}
diff --git a/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionBottomSheetCoordinator.java b/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionBottomSheetCoordinator.java
new file mode 100644
index 0000000..f380efa
--- /dev/null
+++ b/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionBottomSheetCoordinator.java
@@ -0,0 +1,183 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.extensions;
+
+import android.app.Activity;
+import android.graphics.Color;
+import android.content.Context;
+
+import org.chromium.base.version_info.VersionInfo;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetContent;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetController;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetControllerProvider;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetObserver;
+import org.chromium.components.browser_ui.bottomsheet.EmptyBottomSheetObserver;
+import org.chromium.components.embedder_support.view.ContentView;
+import org.chromium.components.thinwebview.ThinWebView;
+import org.chromium.components.thinwebview.ThinWebViewConstraints;
+import org.chromium.components.thinwebview.ThinWebViewFactory;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.base.IntentRequestTracker;
+import org.chromium.ui.base.ViewAndroidDelegate;
+import org.chromium.ui.base.WindowAndroid;
+
+import java.lang.ref.WeakReference;
+
+/**
+ * Manages displaying an extension popup in a BottomSheet.
+ *
+ * <p>Follows the pattern established by PaymentHandlerCoordinator:
+ * WebContents -> ContentView -> ThinWebView -> BottomSheetContent -> BottomSheetController.
+ */
+@NullMarked
+public class ExtensionBottomSheetCoordinator {
+    private @Nullable BottomSheetController mBottomSheetController;
+    private @Nullable ExtensionBottomSheetContent mSheetContent;
+    private @Nullable ThinWebView mThinWebView;
+    private @Nullable ExtensionActionPopupContents mContents;
+    private @Nullable BottomSheetObserver mSheetObserver;
+    private boolean mIsHiding;
+
+    /**
+     * Shows the extension popup in a BottomSheet.
+     *
+     * @param windowAndroid The current {@link WindowAndroid}.
+     * @param contents The {@link ExtensionActionPopupContents} providing the WebContents.
+     * @return {@code true} if the BottomSheet was shown successfully.
+     */
+    public boolean showPopup(WindowAndroid windowAndroid, ExtensionActionPopupContents contents) {
+        WeakReference<Activity> activityRef = windowAndroid.getActivity();
+        if (activityRef == null) return false;
+        Activity activity = activityRef.get();
+        if (activity == null || activity.isFinishing()) return false;
+
+        // コーディネータが再利用された場合に前回の hide でセットされたままの
+        // フラグを戻す (true のままだと以後 hide() が無効になる)。
+        mIsHiding = false;
+
+        mBottomSheetController = BottomSheetControllerProvider.from(windowAndroid);
+        if (mBottomSheetController == null) return false;
+
+        mContents = contents;
+        Context context = activity;
+        WebContents webContents = contents.getWebContents();
+
+        // Create ContentView for the WebContents.
+        ContentView contentView = ContentView.createContentView(context, webContents);
+
+        // Set delegates so the WebContents can render into our view hierarchy.
+        webContents.setDelegates(
+                VersionInfo.getProductVersion(),
+                ViewAndroidDelegate.createBasicDelegate(contentView),
+                contentView,
+                windowAndroid,
+                WebContents.createDefaultInternalsHolder());
+
+        // Create ThinWebView and attach the WebContents.
+        IntentRequestTracker tracker = windowAndroid.getIntentRequestTracker();
+        if (tracker != null) {
+            mThinWebView =
+                    ThinWebViewFactory.create(context, createDarkConstraints(), tracker);
+        } else {
+            mThinWebView =
+                    ThinWebViewFactory.create(context, createDarkConstraints(), windowAndroid);
+        }
+        mThinWebView.attachWebContents(webContents, contentView, null);
+
+        // Wrap in BottomSheetContent.
+        mSheetContent = new ExtensionBottomSheetContent(context, mThinWebView, this::hide);
+
+        // Listen for extension-initiated close (e.g. window.close()).
+        contents.setDelegate(
+                new ExtensionActionPopupContents.Delegate() {
+                    @Override
+                    public void resizeDueToAutoResize(int width, int height) {
+                        // BottomSheet manages its own size; ignore resize requests.
+                    }
+
+                    @Override
+                    public void onLoaded() {}
+
+                    @Override
+                    public void onClose() {
+                        hide();
+                    }
+                });
+
+        // Show the BottomSheet.
+        boolean shown =
+                mBottomSheetController.requestShowContent(mSheetContent, /* animate= */ true);
+        if (!shown) {
+            cleanup();
+            return false;
+        }
+
+        // スワイプダウンなど hide() を経由しない閉じ方はここでしか検知できない。
+        // 検知せずに放置すると WebContents が生存し続け、拡張機能のポップアップ JS
+        // が不可視のまま動き続ける。
+        mSheetObserver =
+                new EmptyBottomSheetObserver() {
+                    @Override
+                    public void onSheetContentChanged(@Nullable BottomSheetContent newContent) {
+                        if (newContent != mSheetContent) {
+                            hide();
+                        }
+                    }
+                };
+        mBottomSheetController.addObserver(mSheetObserver);
+
+        mSheetContent.getContentView().post(() -> {
+            if (mContents != null) {
+                mContents.loadInitialPage();
+            }
+        });
+        return true;
+    }
+
+    /** Hides and cleans up the BottomSheet. */
+    public void hide() {
+        if (mIsHiding) return;
+        mIsHiding = true;
+
+        if (mBottomSheetController != null && mSheetContent != null) {
+            mBottomSheetController.hideContent(mSheetContent, /* animate= */ false);
+        }
+        cleanup();
+    }
+
+    private static ThinWebViewConstraints createDarkConstraints() {
+        ThinWebViewConstraints constraints = new ThinWebViewConstraints();
+        constraints.backgroundColor = Color.BLACK;
+        return constraints;
+    }
+
+    private void cleanup() {
+        if (mBottomSheetController != null && mSheetObserver != null) {
+            mBottomSheetController.removeObserver(mSheetObserver);
+        }
+        mSheetObserver = null;
+
+        // Destroy contents first (destroys native ExtensionViewHost + WebContents).
+        // The ThinWebView's native side holds only a raw pointer to WebContents
+        // that becomes invalid after contents.destroy(), so destroy contents
+        // after detaching from sheet but before ThinWebView is garbage-collected.
+        ExtensionActionPopupContents contentsToDestroy = mContents;
+        mContents = null;
+
+        if (mSheetContent != null) {
+            mSheetContent.destroy();
+            mSheetContent = null;
+        }
+
+        if (contentsToDestroy != null) {
+            contentsToDestroy.destroy();
+        }
+
+        mThinWebView = null;
+        mBottomSheetController = null;
+    }
+}
