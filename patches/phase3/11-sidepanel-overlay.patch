@@ -0,0 +1,73 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.extensions;
+
+import android.app.Activity;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JNINamespace;
+import org.jni_zero.JniType;
+
+import org.chromium.base.ApplicationStatus;
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.ui.base.WindowAndroid;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * JNI bridge for the sidePanel API. Called from C++ when chrome.sidePanel.open()
+ * or chrome.sidePanel.close() is invoked by an extension.
+ */
+@NullMarked
+@JNINamespace("extensions")
+public class ExtensionSidePanelBridge {
+    private static final String TAG = "ExtSidePanelBridge";
+
+    private static @Nullable ExtensionSidePanelCoordinator sCoordinator;
+
+    private ExtensionSidePanelBridge() {}
+
+    /**
+     * Called from C++ when chrome.sidePanel.open() is invoked.
+     *
+     * @param url The chrome-extension:// URL to display in the side panel.
+     * @param senderWebContents The WebContents of the tab that called the API.
+     */
+    @CalledByNative
+    static void showSidePanel(
+            @JniType("std::string") String url,
+            @JniType("content::WebContents*") WebContents senderWebContents) {
+        WindowAndroid windowAndroid = senderWebContents.getTopLevelNativeWindow();
+        if (windowAndroid == null) {
+            Log.w(TAG, "No WindowAndroid available from sender WebContents");
+            return;
+        }
+
+        Activity activity = null;
+        if (windowAndroid.getActivity() != null) {
+            activity = windowAndroid.getActivity().get();
+        }
+        if (activity == null) {
+            Log.w(TAG, "No Activity available from WindowAndroid");
+            return;
+        }
+
+        if (sCoordinator == null) {
+            sCoordinator = new ExtensionSidePanelCoordinator();
+        }
+        sCoordinator.show(activity, windowAndroid, url);
+    }
+
+    /**
+     * Called from C++ when chrome.sidePanel.close() is invoked.
+     */
+    @CalledByNative
+    static void closeSidePanel() {
+        if (sCoordinator != null) {
+            sCoordinator.hide();
+        }
+    }
+}

diff --git a/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionSidePanelCoordinator.java b/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionSidePanelCoordinator.java
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionSidePanelCoordinator.java
@@ -0,0 +1,149 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.extensions;
+
+import android.app.Activity;
+import android.app.Dialog;
+import android.graphics.Color;
+import android.graphics.Point;
+import android.view.Gravity;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+
+import org.chromium.base.Log;
+import org.chromium.base.version_info.VersionInfo;
+import org.chromium.build.NullUtil;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.content.WebContentsFactory;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+import org.chromium.components.embedder_support.view.ContentView;
+import org.chromium.components.thinwebview.ThinWebView;
+import org.chromium.components.thinwebview.ThinWebViewConstraints;
+import org.chromium.components.thinwebview.ThinWebViewFactory;
+import org.chromium.content_public.browser.LoadUrlParams;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.base.IntentRequestTracker;
+import org.chromium.ui.base.ViewAndroidDelegate;
+import org.chromium.ui.base.WindowAndroid;
+
+/**
+ * Manages displaying an extension side panel as a left-sliding overlay Dialog.
+ *
+ * <p>Creates a WebContents to load the side panel HTML, wraps it in a ThinWebView,
+ * and displays it in a Dialog that slides in from the left edge of the screen.
+ */
+@NullMarked
+public class ExtensionSidePanelCoordinator {
+    private static final String TAG = "ExtSidePanel";
+    private static final float WIDTH_RATIO = 0.7f;
+
+    private @Nullable Dialog mDialog;
+    private @Nullable ThinWebView mThinWebView;
+    private @Nullable WebContents mWebContents;
+
+    /**
+     * Shows the side panel overlay.
+     *
+     * @param activity The current Activity.
+     * @param windowAndroid The WindowAndroid for creating ThinWebView.
+     * @param url The chrome-extension:// URL to load in the side panel.
+     */
+    public void show(Activity activity, WindowAndroid windowAndroid, String url) {
+        hide();
+
+        Profile profile = ProfileManager.getLastUsedRegularProfile();
+
+        // Create WebContents for the side panel page.
+        mWebContents =
+                WebContentsFactory.createWebContents(
+                        profile, /* initiallyHidden= */ false, /* initializeRenderer= */ false);
+
+        ContentView contentView = ContentView.createContentView(activity, mWebContents);
+
+        mWebContents.setDelegates(
+                VersionInfo.getProductVersion(),
+                ViewAndroidDelegate.createBasicDelegate(contentView),
+                contentView,
+                windowAndroid,
+                WebContents.createDefaultInternalsHolder());
+
+        // Create ThinWebView.
+        IntentRequestTracker intentRequestTracker = windowAndroid.getIntentRequestTracker();
+        if (intentRequestTracker == null) {
+            Log.w(TAG, "IntentRequestTracker is null, cannot create ThinWebView");
+            cleanup();
+            return;
+        }
+        mThinWebView =
+                ThinWebViewFactory.create(
+                        activity, new ThinWebViewConstraints(), intentRequestTracker);
+        mThinWebView.attachWebContents(mWebContents, contentView, null);
+
+        // Set background to black (same fix as BottomSheet).
+        mThinWebView.getView().setBackgroundColor(Color.BLACK);
+
+        // Calculate dialog width = 70% of screen width.
+        Point displaySize = new Point();
+        activity.getWindowManager().getDefaultDisplay().getSize(displaySize);
+        int panelWidth = (int) (displaySize.x * WIDTH_RATIO);
+
+        // Create the container layout.
+        FrameLayout container = new FrameLayout(activity);
+        container.addView(
+                mThinWebView.getView(),
+                new FrameLayout.LayoutParams(
+                        FrameLayout.LayoutParams.MATCH_PARENT,
+                        FrameLayout.LayoutParams.MATCH_PARENT));
+
+        // Create and configure the Dialog.
+        mDialog = new Dialog(activity, R.style.ExtensionSidePanelAnimation);
+        mDialog.requestWindowFeature(Window.FEATURE_NO_TITLE);
+        mDialog.setContentView(container);
+        mDialog.setCanceledOnTouchOutside(true);
+        mDialog.setOnDismissListener(dialog -> cleanup());
+
+        Window window = mDialog.getWindow();
+        if (window != null) {
+            window.setLayout(panelWidth, WindowManager.LayoutParams.MATCH_PARENT);
+            window.setGravity(Gravity.END);
+            window.setBackgroundDrawableResource(android.R.color.black);
+
+            // Dim background (scrim).
+            window.addFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+            window.setDimAmount(0.4f);
+
+            // Apply slide animation.
+            window.getAttributes().windowAnimations = R.style.ExtensionSidePanelAnimation;
+        }
+
+        mDialog.show();
+
+        // Load the side panel URL.
+        mWebContents.getNavigationController().loadUrl(new LoadUrlParams(url));
+    }
+
+    /** Hides and cleans up the side panel. */
+    public void hide() {
+        if (mDialog != null && mDialog.isShowing()) {
+            mDialog.dismiss();
+        }
+        // cleanup() is called by the dismiss listener.
+    }
+
+    private void cleanup() {
+        if (mThinWebView != null) {
+            mThinWebView.destroy();
+            mThinWebView = null;
+        }
+        if (mWebContents != null) {
+            mWebContents.destroy();
+            mWebContents = null;
+        }
+        mDialog = null;
+    }
+}

