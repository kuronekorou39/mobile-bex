# Patch 12: sidePanel C++ 側の挙動修正
# - Service Worker からの sidePanel.open() 対応 (tabId 解決)
# - sidepanel 拡張の onClicked ディスパッチ許可 (extension_action_runner)
diff --git a/chrome/browser/extensions/api/side_panel/BUILD.gn b/chrome/browser/extensions/api/side_panel/BUILD.gn
index 49eea48..cc71a90 100644
--- a/chrome/browser/extensions/api/side_panel/BUILD.gn
+++ b/chrome/browser/extensions/api/side_panel/BUILD.gn
@@ -24,4 +24,12 @@ source_set("side_panel") {
     "//chrome/browser/extensions",
     "//chrome/common/extensions/api",
   ]
+
+  if (is_android) {
+    deps += [
+      "//chrome/browser/ui/android/extensions:jni_headers",
+      "//chrome/common/extensions",
+      "//content/public/browser",
+    ]
+  }
 }
diff --git a/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc b/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc
index 483f5cc..a32c0b2 100644
--- a/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc
+++ b/chrome/browser/extensions/api/side_panel/side_panel_api_stub.cc
@@ -3,13 +3,21 @@
 // found in the LICENSE file.
 
 // Stub implementation of the sidePanel API for desktop-android.
-// All functions are no-op or return sensible defaults.
-// The real implementation (side_panel_api.cc) depends on SidePanelService
-// which requires desktop browser_ui and is not available on Android.
+// Most functions are no-op or return sensible defaults.
+// open() and close() call through JNI to show/hide a right-slide overlay.
 
 #include "chrome/browser/extensions/api/side_panel/side_panel_api.h"
 
 #include "chrome/common/extensions/api/side_panel.h"
+#include "chrome/common/extensions/api/side_panel/side_panel_info.h"
+#include "extensions/common/extension.h"
+
+#if BUILDFLAG(IS_ANDROID)
+#include "base/android/jni_string.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "content/public/browser/web_contents.h"
+#include "chrome/browser/ui/android/extensions/jni_headers/ExtensionSidePanelBridge_jni.h"
+#endif
 
 namespace extensions {
 
@@ -50,8 +58,44 @@ SidePanelGetPanelBehaviorFunction::RunFunction() {
   return RespondNow(WithArguments(behavior.ToValue()));
 }
 
-// open -> no-op (could open as tab in the future)
+// open -> show right-slide overlay via JNI
+// Supports calls from both popup context and service worker context.
+// When called from a service worker (e.g., via action.onClicked handler),
+// GetSenderWebContents() returns null, so we resolve the tab's WebContents
+// from the tabId parameter instead.
 ExtensionFunction::ResponseAction SidePanelOpenFunction::RunFunction() {
+#if BUILDFLAG(IS_ANDROID)
+  const Extension* ext = extension();
+  if (!ext || !SidePanelInfo::HasSidePanel(ext)) {
+    return RespondNow(NoArguments());
+  }
+
+  content::WebContents* web_contents = nullptr;
+
+  // Try to get WebContents from the tabId argument first.
+  // This is critical for service worker calls where GetSenderWebContents()
+  // returns null.
+  auto params = api::side_panel::Open::Params::Create(args());
+  if (params && params->options.tab_id) {
+    ExtensionTabUtil::GetTabById(
+        *params->options.tab_id,
+        browser_context(),
+        include_incognito_information(),
+        &web_contents);
+  }
+
+  // Fall back to sender WebContents (works for popup context).
+  if (!web_contents) {
+    web_contents = GetSenderWebContents();
+  }
+
+  if (web_contents) {
+    std::string path = SidePanelInfo::GetDefaultPath(ext);
+    GURL url = ext->GetResourceURL(path);
+    Java_ExtensionSidePanelBridge_showSidePanel(
+        base::android::AttachCurrentThread(), url.spec(), web_contents);
+  }
+#endif
   return RespondNow(NoArguments());
 }
 
@@ -61,8 +105,12 @@ ExtensionFunction::ResponseAction SidePanelGetLayoutFunction::RunFunction() {
   return RespondNow(WithArguments(layout.ToValue()));
 }
 
-// close -> no-op
+// close -> hide overlay via JNI
 ExtensionFunction::ResponseAction SidePanelCloseFunction::RunFunction() {
+#if BUILDFLAG(IS_ANDROID)
+  Java_ExtensionSidePanelBridge_closeSidePanel(
+      base::android::AttachCurrentThread());
+#endif
   return RespondNow(NoArguments());
 }
 
