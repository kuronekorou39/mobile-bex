@@ -21,9 +22,21 @@ namespace {
 base::android::ScopedJavaLocalRef<jobject> CreateJavaControlState(
     JNIEnv* env,
     const ExtensionsMenuViewModel::ControlState& state) {
+  // Convert icon to Java Bitmap if available.
+  base::android::ScopedJavaLocalRef<jobject> j_icon;
+  if (!state.icon.IsEmpty() && state.icon.IsImage()) {
+    gfx::ImageSkia image_skia = state.icon.GetImage().AsImageSkia();
+    if (!image_skia.isNull()) {
+      const SkBitmap& bitmap =
+          image_skia.GetRepresentation(1.0f).GetBitmap();
+      if (!bitmap.isNull()) {
+        j_icon = gfx::ConvertToJavaBitmap(bitmap);
+      }
+    }
+  }
   return extensions::Java_ControlState_Constructor(
       env, static_cast<int>(state.status), state.text, state.accessible_name,
-      state.tooltip_text, state.is_on);
+      state.tooltip_text, state.is_on, j_icon);
 }
 
 }  // namespace
