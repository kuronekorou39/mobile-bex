@@ -1152,6 +1152,27 @@ class AutocompleteMediator
                     System.currentTimeMillis()
                             - assumeNonNull(mAutocompleteInput).getUrlFocusTime());
 
+            // Check if this is an extension keyword match. If so, dispatch
+            // onInputEntered to the extension instead of navigating.
+            if (mAutocomplete != null) {
+                var tab = mDataProvider.getTab();
+                WebContents webContents = tab != null ? tab.getWebContents() : null;
+                boolean extensionResult =
+                        mAutocomplete.processExtensionKeywordMatch(suggestion, webContents);
+                if (extensionResult) {
+                    mDeferredLoadAction = null;
+                    mOmniboxFocusResultedInNavigation = true;
+                    recordMetrics(
+                            suggestion, null, matchIndex, WindowOpenDisposition.CURRENT_TAB);
+                    // Extension handled the keyword via onInputEntered; dismiss the omnibox
+                    // and suggestion list the same way the normal navigation path does,
+                    // otherwise the suggestions keep obscuring the page the extension
+                    // navigated to (chrome.tabs.update already committed the navigation).
+                    mHandler.post(this::finishInteraction);
+                    return;
+                }
+            }
+
             // Clear the deferred site load action in case it executes. Reclaims a bit of memory.
             mDeferredLoadAction = null;
 
