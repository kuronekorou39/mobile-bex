diff --git a/chrome/browser/resources/extensions/toolbar.css b/chrome/browser/resources/extensions/toolbar.css
index 7e723e0284..7092a6668e 100644
--- a/chrome/browser/resources/extensions/toolbar.css
+++ b/chrome/browser/resources/extensions/toolbar.css
@@ -79,3 +79,26 @@ cr-toolbar {
   --cr-toolbar-field-width: 100%;
   --cr-toolbar-header-white-space: nowrap;
 }
+
+/* mobile-bex: phone layout */
+@media (max-width: 680px) {
+  #buttonStrip {
+    position: static;
+    width: auto;
+    margin-inline: 12px;
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px;
+  }
+  #buttonStrip cr-button {
+    margin-inline-end: 0;
+    max-width: 100%;
+  }
+  /* Pack ボタンはモバイルではほぼ使わないため非表示 */
+  #packExtensions {
+    display: none;
+  }
+  #devDrawer[expanded] {
+    height: auto;
+  }
+}
