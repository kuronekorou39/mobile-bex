         mButtonData.setButtonSpec(
                 buttonSpecWithDrawableAndDescription(mButtonData.getButtonSpec(), profileData));
-        mButtonData.setCanShow(true);
+        // mobile-bex: ツールバーのアカウントアイコンは出さない。端末へのアカウント
+        // 追加に対応していないため、開いても操作できる項目がない (Patch 21)。
+        mButtonData.setCanShow(false);
     }
 
     private ButtonSpec buttonSpecWithDrawableAndDescription(
diff --git a/chrome/browser/ui/android/signin/java/src/org/chromium/chrome/browser/ui/signin/signin_promo/NtpSigninPromoDelegate.java b/chrome/browser/ui/android/signin/java/src/org/chromium/chrome/browser/ui/signin/signin_promo/NtpSigninPromoDelegate.java
index c7a41cd..5aa655b 100644
--- a/chrome/browser/ui/android/signin/java/src/org/chromium/chrome/browser/ui/signin/signin_promo/NtpSigninPromoDelegate.java
+++ b/chrome/browser/ui/android/signin/java/src/org/chromium/chrome/browser/ui/signin/signin_promo/NtpSigninPromoDelegate.java
@@ -173,7 +173,16 @@ public class NtpSigninPromoDelegate extends SigninPromoDelegate {
 
     @Override
     boolean canShowPromo() {
-        return mPromoState != PromoState.NONE;
+        // mobile-bex: 新しいタブの「Chrome にログイン」カードは出さない。このビルドは
+        // 端末にアカウントを追加できないため、ログインを勧めても何も起きない (Patch 21)。
+        //
+        // ここで止めるのは、このデリゲートが表示経路の合流点だから。プロモには Feed 経路
+        // (FeedSurfaceMediator) と NTP 経路 (NewTabPageLayout → NtpSigninPromoCoordinator)
+        // があり、kEnableSeamlessSignin で排他になっている。あのフラグはコード上
+        // FEATURE_DISABLED_BY_DEFAULT だが、fieldtrial_testing_config.json の
+        // SeamlessSigninClank が有効化するため、公式ビルドでない限り実際には有効。
+        // つまり動いているのは NTP 経路のほうで、Feed 経路だけ塞いでも意味がない。
+        return false;
     }
 
     @Override
diff --git a/components/signin/public/android/java/src/org/chromium/components/signin/NullAccountManagerDelegate.java b/components/signin/public/android/java/src/org/chromium/components/signin/NullAccountManagerDelegate.java
