# Patch 22: フォルダ選択が Android 15+ で常に失敗する問題を修正
# checkContentUriPermission() はツリー URI を評価できず例外を投げるため、
# 未パッケージ拡張機能の読み込み (フォルダ選択) が無言で却下されていた。
diff --git a/ui/android/java/src/org/chromium/ui/base/SelectFileDialog.java b/ui/android/java/src/org/chromium/ui/base/SelectFileDialog.java
index 9d93f17..00559b3 100644
--- a/ui/android/java/src/org/chromium/ui/base/SelectFileDialog.java
+++ b/ui/android/java/src/org/chromium/ui/base/SelectFileDialog.java
@@ -1819,6 +1819,15 @@ public class SelectFileDialog implements WindowAndroid.IntentCallback, PhotoPick
         if (activity == null) {
             return false;
         }
+        // checkContentUriPermission() はドキュメント URI しか評価できず、
+        // ACTION_OPEN_DOCUMENT_TREE が返すツリー URI に対しては
+        // UnsupportedOperationException を投げる。そのまま catch すると false に
+        // なり、フォルダ選択 (未パッケージ拡張機能の読み込み等) が Android 15+ で
+        // 常に無言で失敗する。ツリー URI はシステムのピッカー経由でのみ得られ、
+        // 呼び出し元アプリが渡してくるものではないためチェック対象外とする。
+        if (DocumentsContract.isTreeUri(uri)) {
+            return true;
+        }
         try {
             return activity.getCurrentCaller()
                             .checkContentUriPermission(uri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
