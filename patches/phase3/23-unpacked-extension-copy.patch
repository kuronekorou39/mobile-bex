+
+  // SAF パスのまま読み込むと拡張機能側の各所が破綻する: FileEnumerator が
+  // content URI を返すため親子パスの整合が崩れ、_locales を持つ拡張機能では
+  // extension_l10n_util の NOTREACHED に到達してブラウザごと落ちる。加えて
+  // SAF の権限は再起動で失われうるため、次回起動時の再読み込みも失敗する。
+  // プロファイル配下にコピーしてから通常のパスとして読み込む。
+  const base::FilePath dest_root =
+      browser_context()->GetPath().Append(kUnpackedExtensionsDir);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&CopyUnpackedExtensionToProfile, file_path, dest_root),
+      base::BindOnce(
+          &DeveloperPrivateLoadUnpackedFunction::OnUnpackedDirectoryCopied,
+          this, file_path));
+}
+
+void DeveloperPrivateLoadUnpackedFunction::OnUnpackedDirectoryCopied(
+    const base::FilePath& source_path,
