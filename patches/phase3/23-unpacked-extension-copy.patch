+  if (local_path.empty()) {
+    OnLoadComplete(nullptr, source_path,
+                   u"Failed to copy the extension directory");
+    return;
+  }
+  // コピー中にプロファイルが破棄された場合。
+  if (!browser_context()) {
+    OnLoadComplete(nullptr, source_path, u"Browser context is gone");
+    return;
+  }
+  const base::FilePath file_path = local_path;
 #endif  // BUILDFLAG(IS_ANDROID)
