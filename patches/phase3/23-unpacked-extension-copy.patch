+#if BUILDFLAG(IS_ANDROID)
+
+// 拡張機能のコピー先 (プロファイル直下)。
+constexpr base::FilePath::CharType kUnpackedExtensionsDir[] =
+    FILE_PATH_LITERAL("Unpacked Extensions");
+
+// 拡張機能ディレクトリのネスト上限。SAF の表示名を辿るため、壊れた/悪意ある
+// 階層で無限再帰しないよう保険をかける。
+constexpr int kMaxCopyDepth = 16;
+
+// SAF (content URI) のディレクトリツリーをローカルファイルシステムへ再帰的に
+// コピーする。base::CopyDirectory は MakeAbsoluteFilePath や AppendRelativePath
+// に依存しており content URI では機能しないため、独自に実装している。
+bool CopySafDirectory(const base::FilePath& from_dir,
+                      const base::FilePath& to_dir,
+                      int depth) {
+  if (depth > kMaxCopyDepth) {
+    LOG(ERROR) << "Unpacked extension directory nested too deeply";
+    return false;
+  }
+  if (!base::CreateDirectory(to_dir)) {
+    return false;
+  }
+
+  base::FileEnumerator files(
+      from_dir, /*recursive=*/false,
+      base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath child = files.Next(); !child.empty();
+       child = files.Next()) {
+    base::FileEnumerator::FileInfo info = files.GetInfo();
+    // SAF では Next() が content URI を返すため、名前は必ず GetInfo() から取る
+    // (content URI の BaseName() はエンコード済みドキュメントIDになる)。
+    const base::FilePath name = info.GetName();
+    // 表示名はプロバイダ由来の任意文字列。ディレクトリ脱出を防ぐ。
+    if (name.empty() || name.IsAbsolute() || name.ReferencesParent() ||
+        name.value().find(base::FilePath::kSeparators[0]) !=
+            base::FilePath::StringType::npos) {
+      LOG(ERROR) << "Skipping entry with unsafe name in unpacked extension";
+      continue;
+    }
+
+    const base::FilePath dest = to_dir.Append(name);
+    if (info.IsDirectory()) {
+      if (!CopySafDirectory(child, dest, depth + 1)) {
+        return false;
+      }
+    } else {
+      std::string contents;
+      if (!base::ReadFileToString(child, &contents) ||
+          !base::WriteFile(dest, contents)) {
+        LOG(ERROR) << "Failed to copy " << name;
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+// `source_path` (SAF) をプロファイル配下にコピーし、コピー先を返す。失敗時は
+// 空パス。ブロッキング I/O のためワーカースレッドで実行すること。
+base::FilePath CopyUnpackedExtensionToProfile(const base::FilePath& source_path,
+                                              const base::FilePath& dest_root) {
+  // 同じフォルダを読み込み直したときに同じ場所へ上書きされるよう、コピー先名は
+  // 元パスから決定的に導出する。
+  const std::string dir_name = base::StringPrintf(
+      "%08x", base::PersistentHash(source_path.value()));
+  const base::FilePath dest = dest_root.AppendASCII(dir_name);
+
+  // 前回の内容が残っていると削除されたファイルが復活するため、作り直す。
+  base::DeletePathRecursively(dest);
+  if (!CopySafDirectory(source_path, dest, /*depth=*/0)) {
+    base::DeletePathRecursively(dest);
+    return base::FilePath();
+  }
+  return dest;
+}
+
+#endif  // BUILDFLAG(IS_ANDROID)
+
 }  // namespace
 
