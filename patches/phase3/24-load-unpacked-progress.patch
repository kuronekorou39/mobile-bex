# Patch 24: 未パッケージ拡張機能の読み込み中に進捗プレースホルダを表示
# フォルダ選択後のコピー/検証に時間がかかるが画面に変化がなく、
# 固まったように見えていたため。点線枠のカード + スピナーを出す。
diff --git a/chrome/app/extensions_strings.grdp b/chrome/app/extensions_strings.grdp
index 81bbf87..b9b6630 100644
--- a/chrome/app/extensions_strings.grdp
+++ b/chrome/app/extensions_strings.grdp
@@ -553,6 +553,12 @@
   <message name="IDS_EXTENSIONS_TOOLBAR_LOAD_UNPACKED_DONE" desc="Text displayed in a toast popup message when extension has been loaded.">
     Extension loaded
   </message>
+  <message name="IDS_EXTENSIONS_TOOLBAR_LOAD_UNPACKED_LOADING" desc="Title of the placeholder card shown while an unpacked extension is being loaded.">
+    Loading extension...
+  </message>
+  <message name="IDS_EXTENSIONS_TOOLBAR_LOAD_UNPACKED_LOADING_SUBTITLE" desc="Subtitle of the placeholder card shown while an unpacked extension is being loaded, explaining that files are being copied.">
+    Copying and verifying files. This may take a while for large extensions.
+  </message>
   <message name="IDS_EXTENSIONS_TOOLBAR_PACK" desc="The text displayed in the toolbar to pack an extension directory.">
     Pack extension
   </message>
diff --git a/chrome/browser/resources/extensions/item_list.html.ts b/chrome/browser/resources/extensions/item_list.html.ts
index 054f137..664ba27 100644
--- a/chrome/browser/resources/extensions/item_list.html.ts
+++ b/chrome/browser/resources/extensions/item_list.html.ts
@@ -43,6 +43,25 @@ export function getHtml(this: ExtensionsItemListElement) {
       <span>$i18n{noSearchResults}</span>
     </div>
 
+    <!-- 未パッケージ拡張機能の読み込み中プレースホルダ。フォルダ選択後の
+         コピーと検証には時間がかかるため、進行中であることを明示する。 -->
+    <div id="loading-section" ?hidden="${!this.isLoadingUnpacked}">
+      <h2 class="section-header items-container">
+        $i18n{extensionsSectionHeader}
+      </h2>
+      <div class="items-container">
+        <div id="loading-placeholder">
+          <div class="loading-spinner"></div>
+          <div class="loading-text">
+            <div class="loading-title">$i18n{toolbarLoadUnpackedLoading}</div>
+            <div class="loading-subtitle">
+              $i18n{toolbarLoadUnpackedLoadingSubtitle}
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+
     <div id="extensions-section" ?hidden="${!this.shownExtensionsCount_}">
       <!-- section-header needs to left-align with the grid content below, and
            the easiest way to achieve this is to make it a grid as well. -->
