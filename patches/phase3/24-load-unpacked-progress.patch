# Patch 24: 未パッケージ拡張機能の読み込み中に進捗プレースホルダを表示
# フォルダ選択後のコピー/検証に時間がかかるが画面に変化がなく、
# 固まったように見えていたため。点線枠のカード + スピナーを出す。
diff --git a/chrome/app/extensions_strings.grdp b/chrome/app/extensions_strings.grdp
index e11300d..9c1bedb 100644
--- a/chrome/app/extensions_strings.grdp
+++ b/chrome/app/extensions_strings.grdp
@@ -547,6 +547,12 @@
   <message name="IDS_EXTENSIONS_TOOLBAR_LOAD_UNPACKED_DONE" desc="Text displayed in a toast popup message when extension has been loaded.">
     Extension loaded
   </message>
+  <message name="IDS_EXTENSIONS_TOOLBAR_LOAD_UNPACKED_LOADING" desc="Title of the placeholder card shown while an unpacked extension is being loaded.">
+    Loading extension...
+  </message>
+  <message name="IDS_EXTENSIONS_TOOLBAR_LOAD_UNPACKED_LOADING_SUBTITLE" desc="Subtitle of the placeholder card shown while an unpacked extension is being loaded, explaining that files are being copied.">
+    Copying and verifying files. This may take a while for large extensions.
+  </message>
   <message name="IDS_EXTENSIONS_TOOLBAR_PACK" desc="The text displayed in the toolbar to pack an extension directory.">
     Pack extension
   </message>
diff --git a/chrome/browser/resources/extensions/item_list.css b/chrome/browser/resources/extensions/item_list.css
index 6abd620..1fecd74 100644
--- a/chrome/browser/resources/extensions/item_list.css
+++ b/chrome/browser/resources/extensions/item_list.css
@@ -113,3 +113,51 @@ managed-footnote {
     max-width: none;
   }
 }
+
+/* mobile-bex: 未パッケージ拡張機能の読み込み中プレースホルダ。
+ * 拡張機能カードと同じ枠内に点線で表示し、処理中であることを示す。 */
+#loading-placeholder {
+  align-items: center;
+  border: 2px dashed var(--color-side-panel-card-primary-foreground,
+                        var(--cr-secondary-text-color));
+  border-radius: var(--cr-card-border-radius, 12px);
+  box-sizing: border-box;
+  display: flex;
+  gap: 16px;
+  min-height: 80px;
+  opacity: 0.85;
+  padding: 20px;
+}
+
+#loading-placeholder .loading-spinner {
+  animation: bex-spin 900ms linear infinite;
+  border: 3px solid var(--cr-separator-color, rgba(0, 0, 0, 0.15));
+  border-radius: 50%;
+  border-top-color: var(--cr-link-color, #1a73e8);
+  flex-shrink: 0;
+  height: 24px;
+  width: 24px;
+}
+
+@keyframes bex-spin {
+  to { transform: rotate(360deg); }
+}
+
+#loading-placeholder .loading-title {
+  color: var(--cr-primary-text-color);
+  font-size: 100%;
+  font-weight: 500;
+}
+
+#loading-placeholder .loading-subtitle {
+  color: var(--cr-secondary-text-color);
+  font-size: 90%;
+  margin-top: 4px;
+}
+
+/* 「動きを減らす」設定を尊重する */
+@media (prefers-reduced-motion: reduce) {
+  #loading-placeholder .loading-spinner {
+    animation-duration: 3s;
+  }
+}
