@@ -65,12 +65,21 @@ class ExtensionActionPopupContents : public content::WebContentsObserver,
   // hosted WebContents.
   void LoadInitialPage(JNIEnv* env);
 
+  // Called from Java when the popup should lay out at the full width of the
+  // bottom sheet instead of its natural (content) width. Used for popups whose
+  // layout is fluid; see ExtensionBottomSheetCoordinator.
+  void SetFullWidth(JNIEnv* env);
+
  private:
   void SetUpNewMainFrame(content::RenderFrameHost* render_frame_host);
   void HandleCloseExtensionHost(extensions::ExtensionHost* host);
+  // Applies the auto-resize bounds, taking `full_width_` into account.
+  void ApplyAutoResizeBounds(content::RenderFrameHost* render_frame_host);
 
   std::unique_ptr<ExtensionViewHost> host_;
   base::android::ScopedJavaGlobalRef<jobject> java_object_;
+  // Whether the popup is forced to lay out at the available (sheet) width.
+  bool full_width_ = false;
 };
 
 }  // namespace extensions
diff --git a/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionActionPopupContents.java b/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionActionPopupContents.java
index 8f0ff85..f0e40b6 100644
--- a/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionActionPopupContents.java
+++ b/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionActionPopupContents.java
@@ -83,6 +83,15 @@ public class ExtensionActionPopupContents implements Destroyable {
         ExtensionActionPopupContentsJni.get().loadInitialPage(mNativeExtensionActionPopupContents);
     }
 
+    /**
