# Patch 25: ポップアップの幅の扱いを改善
# 可変レイアウトのポップアップをシート幅いっぱいに広げられるようにし、
# 上流の最大幅 800dip がスマホ画面より広く見切れる問題も修正する。
# (シート側の透過・サイズ追従は Patch 09 に含まれる)
diff --git a/chrome/browser/ui/android/extensions/extension_action_popup_contents.cc b/chrome/browser/ui/android/extensions/extension_action_popup_contents.cc
index 5b7959f..1d8f894 100644
--- a/chrome/browser/ui/android/extensions/extension_action_popup_contents.cc
+++ b/chrome/browser/ui/android/extensions/extension_action_popup_contents.cc
@@ -12,6 +12,8 @@
 #include "chrome/browser/ui/browser_window/internal/android/android_browser_window.h"
 #include "content/public/browser/render_widget_host_view.h"
 #include "content/public/browser/web_contents.h"
+#include "ui/display/display.h"
+#include "ui/display/screen.h"
 #include "extensions/browser/extension_action.h"
 #include "extensions/browser/extension_action_manager.h"
 #include "extensions/browser/extension_registry.h"
@@ -34,6 +36,17 @@ namespace {
 constexpr gfx::Size kMinSize = {25, 25};
 constexpr gfx::Size kMaxSize = {800, 600};
 
+// mobile-bex: ポップアップは BottomSheet に画面幅いっぱいで表示されるため、
+// 利用可能な幅 (= 画面幅) を DIP で返す。上流のデフォルト最大幅 800 DIP は
+// スマホの画面幅より広く、そのままだとシートに収まらないポップアップが
+// 見切れる。0 は不明。
+int GetAvailableWidthDip() {
+  if (!display::Screen::HasScreen()) {
+    return 0;
+  }
+  return display::Screen::Get()->GetPrimaryDisplay().size().width();
+}
+
 }  // namespace
 
 ExtensionActionPopupContents::ExtensionActionPopupContents(
@@ -121,7 +134,51 @@ void ExtensionActionPopupContents::LoadInitialPage(JNIEnv* env) {
 
 void ExtensionActionPopupContents::SetUpNewMainFrame(
     RenderFrameHost* render_frame_host) {
-  render_frame_host->GetView()->EnableAutoResize(kMinSize, kMaxSize);
+  ApplyAutoResizeBounds(render_frame_host);
+}
+
+void ExtensionActionPopupContents::ApplyAutoResizeBounds(
+    RenderFrameHost* render_frame_host) {
+  if (!render_frame_host || !render_frame_host->GetView()) {
+    return;
+  }
+
+  if (!sheet_size_.IsEmpty()) {
+    // シート全体を埋めるサイズで固定する。自動サイズのままだと、内容が
+    // 短いポップアップの下に BottomSheet 自身の背景 (ライトテーマでは純白)
+    // が露出してしまう。ポップアップ自身の背景で埋めさせることで、
+    // ダーク/ライトどちらのポップアップでも見た目が一貫する。
+    // (描画領域そのものを縮める方法は ThinWebView のリサイズが必要で、
+    //  それを行うとポップアップが描画されなくなる。Patch 09 のコメント参照)
+    render_frame_host->GetView()->EnableAutoResize(sheet_size_, sheet_size_);
+    return;
+  }
+
+  gfx::Size min_size = kMinSize;
+  gfx::Size max_size = kMaxSize;
+  const int available_width = GetAvailableWidthDip();
+  if (available_width > 0) {
+    // シートより広く描かせない (はみ出すと見切れる)。
+    max_size.set_width(available_width);
+  }
+  min_size.SetToMin(max_size);
+  render_frame_host->GetView()->EnableAutoResize(min_size, max_size);
+}
+
+void ExtensionActionPopupContents::SetSheetSize(JNIEnv* env,
+                                                int width_dip,
+                                                int height_dip) {
+  if (width_dip <= 0 || height_dip <= 0) {
+    return;
+  }
+  const gfx::Size new_size(width_dip, height_dip);
+  if (sheet_size_ == new_size) {
+    return;
+  }
+  sheet_size_ = new_size;
+  if (host_) {
+    ApplyAutoResizeBounds(host_->main_frame_host());
+  }
 }
 
