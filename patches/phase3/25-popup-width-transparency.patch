+
     /**
      * Sets the delegate to receive UI-related callbacks for this popup.
      *
@@ -155,5 +164,12 @@ public class ExtensionActionPopupContents implements Destroyable {
          * @param nativeExtensionActionPopupContents The pointer to the native object.
          */
         void loadInitialPage(long nativeExtensionActionPopupContents);
+
+        /**
+         * Makes the popup lay out at the full available width instead of its content width.
+         *
+         * @param nativeExtensionActionPopupContents The pointer to the native object.
+         */
+        void setFullWidth(long nativeExtensionActionPopupContents);
     }
 }
