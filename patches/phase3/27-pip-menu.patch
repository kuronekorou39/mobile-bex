+    /**
+     * mobile-bex: 小窓 (picture-in-picture) 表示中はツールバーを隠し、ページの内容だけを
+     * 表示する。小窓ではどのみち操作できないうえ、面積の大半を占めてしまうため。
+     *
+     * <p>VR モード (onEnterVr) が同じことをしているので、同じ仕組みに乗っている。
+     */
+    @Override
+    public void onPictureInPictureModeChanged(
+            boolean isInPictureInPictureMode, Configuration newConfig) {
+        super.onPictureInPictureModeChanged(isInPictureInPictureMode, newConfig);
+
+        if (mControlContainer == null) return;
+
+        if (isInPictureInPictureMode) {
+            mControlContainer.setVisibility(View.INVISIBLE);
+            if (mBexPipBrowserControlsVisibilityDelegate == null) {
+                mBexPipBrowserControlsVisibilityDelegate = new BrowserControlsVisibilityDelegate();
+                getAppBrowserControlsVisibilityDelegate()
+                        .addDelegate(mBexPipBrowserControlsVisibilityDelegate);
+            }
+            mBexPipBrowserControlsVisibilityDelegate.set(BrowserControlsState.HIDDEN);
+        } else {
+            mControlContainer.setVisibility(View.VISIBLE);
+            if (mBexPipBrowserControlsVisibilityDelegate != null) {
+                mBexPipBrowserControlsVisibilityDelegate.set(BrowserControlsState.BOTH);
+            }
+        }
+    }
+
