+    /**
+     * mobile-bex: ブラウザ全体を picture-in-picture の小窓に縮小する。
+     *
+     * <p>上流の PiP は「全画面再生中の動画が1つある」ときにしか発動しないため、
+     * 複数の配信を並べるような拡張機能では使えない。ここでは動画の有無に関係なく
+     * Activity ごと小窓化する (Custom Tab の最小化と同じ手法)。
+     */
+    private void enterPictureInPictureFromMenu() {
+        if (isInPictureInPictureMode() || isFinishing()) return;
+
+        PictureInPictureParams.Builder builder =
+                new PictureInPictureParams.Builder()
+                        .setAspectRatio(BEX_PIP_ASPECT_RATIO);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            builder.setSeamlessResizeEnabled(false);
+        }
+
+        // 端末によっては framework 側で例外が投げられることがある。小窓化に
+        // 失敗してもブラウザごと落とす理由はないので、握って続行する。
+        try {
+            enterPictureInPictureMode(builder.build());
+        } catch (IllegalStateException | IllegalArgumentException | NullPointerException e) {
+            Log.w(TAG, "Failed to enter picture-in-picture", e);
+        }
+    }
+
