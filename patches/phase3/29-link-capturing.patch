# Patch 29: リンクを踏んでも勝手にアプリへ飛ばないようにする
# 対応するアプリが入っているリンク (twitch.tv に対する Twitch アプリ等) を踏むと、
# ブラウザ内で開かずにそのアプリが起動してしまい、ブラウザとして使えなかった。
#
# Chromium 153 では上流が DesktopAndroidLinkCapturing を C++/Java とも既定で有効に
# したので、そこは不要になった。残る用事は2つ。
#
#   1. OpenInAppUtils#isOpenInAppAvailable() から DeviceInfo.isDesktop() の条件を外す。
#      あれは android.hardware.type.pc を持つ端末 (ChromeOS 等) でないと true に
#      ならず、普通のスマホでは常に無効になってしまう。
#   2. omnibox のチップを出さない。URL バーに被さって常に見えているのが邪魔なため。
#      上流はチップを出している間だけメニュー項目を隠す作りなので、チップを出さない
#      ことにすれば「アプリで開く」は常に三点メニューから使える。
#
# mailto: や tel: は http/https 判定の外なので、これまでどおりアプリに渡る。
diff --git a/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/OpenInAppUtils.java b/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/OpenInAppUtils.java
index 7bffc96..c3c65d6 100644
--- a/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/OpenInAppUtils.java
+++ b/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/OpenInAppUtils.java
@@ -4,7 +4,6 @@
 
 package org.chromium.chrome.browser.open_in_app;
 
-import org.chromium.base.DeviceInfo;
 import org.chromium.build.annotations.NullMarked;
 import org.chromium.chrome.browser.flags.ChromeFeatureList;
 
@@ -14,7 +13,11 @@ public class OpenInAppUtils {
 
     /** Returns whether Open in App is available. */
     public static boolean isOpenInAppAvailable() {
-        return ChromeFeatureList.sDesktopAndroidLinkCapturing.isEnabled() && DeviceInfo.isDesktop();
+        // mobile-bex: 上流は DeviceInfo.isDesktop() も条件にしているが、あれは
+        // android.hardware.type.pc を持つ端末 (ChromeOS 等) でないと true にならず、
+        // 普通のスマホでは常に無効になってしまう。このブラウザはスマホで使うものなので
+        // 端末の条件は外し、フラグだけで判定する。
+        return ChromeFeatureList.sDesktopAndroidLinkCapturing.isEnabled();
     }
 
     private OpenInAppUtils() {}
diff --git a/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/TabbedOpenInAppEntryPoint.java b/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/TabbedOpenInAppEntryPoint.java
index 28da21a..9b6e6e8 100644
--- a/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/TabbedOpenInAppEntryPoint.java
+++ b/chrome/browser/open_in_app/android/java/src/org/chromium/chrome/browser/open_in_app/TabbedOpenInAppEntryPoint.java
@@ -4,12 +4,8 @@
 
 package org.chromium.chrome.browser.open_in_app;
 
-import static org.chromium.build.NullUtil.assertNonNull;
-
 import android.content.Context;
-import android.graphics.drawable.Drawable;
 
-import org.chromium.base.metrics.RecordHistogram;
 import org.chromium.base.supplier.NullableObservableSupplier;
 import org.chromium.build.annotations.NullMarked;
 import org.chromium.build.annotations.Nullable;
@@ -39,28 +35,12 @@ public class TabbedOpenInAppEntryPoint extends OpenInAppEntryPoint {
 
     @Override
     protected void onOpenInAppInfoChanged(OpenInAppDelegate.@Nullable OpenInAppInfo openInAppInfo) {
-        if (openInAppInfo == null && mOmniboxChipManager.isChipPlaced()) {
+        // mobile-bex: omnibox のチップは出さない。URL バーに被さって常に見えているのが
+        // 邪魔なため。上流はチップを出している間だけメニュー項目を隠す作りなので
+        // (getOpenInAppInfoForMenuItem のオーバーライド)、チップを出さないことにすれば
+        // 「アプリで開く」は常に三点メニューから使える。
+        if (mOmniboxChipManager.isChipPlaced()) {
             mOmniboxChipManager.dismissChip();
-        } else if (openInAppInfo != null) {
-            Drawable icon = openInAppInfo.appIcon;
-            if (icon == null) {
-                icon = assertNonNull(mContext.getDrawable(R.drawable.ic_open_in_new_20dp));
-            }
-
-            String text = mContext.getString(R.string.open_in_app);
-            String desc =
-                    openInAppInfo.appName != null
-                            ? mContext.getString(R.string.open_in_app_desc, openInAppInfo.appName)
-                            : text;
-
-            Runnable chipAction =
-                    () -> {
-                        RecordHistogram.recordBooleanHistogram(
-                                "Android.OpenInApp.Clicked.OmniboxChip", true);
-                        openInAppInfo.action.run();
-                    };
-
-            mOmniboxChipManager.placeChip(text, icon, desc, chipAction);
         }
     }
 }
