# Patch 31: スマホでも「新しいウィンドウ」を出す
# マルチインスタンスの仕組み自体は上流に揃っている (ChromeTabbedActivity2 が
# AndroidManifest にあり、new_window_menu_id のハンドラも MultiInstanceManagerImpl
# にある)。出ていなかったのはメニューの表示条件だけだった。
#
# 上流は「On phones, show the menu only when in split-screen」として、スマホでは
# すでに分割画面に入っているときしか出さない。しかしそれでは分割画面にするために
# 先に分割画面が要るという堂々巡りで、実質使えない。画面サイズの条件を外し、
# 2つ目のウィンドウを開いてからタスクスイッチャーで並べられるようにする。
#
# インスタンス数の上限 (getMaxInstances) は端末のメモリ量で決まるので触っていない。
# Pixel 9a では 20 まで許可される。
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
index c56b5e0..51e4011 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tabbed_mode/TabbedAppMenuPropertiesDelegate.java
@@ -1637,14 +1637,18 @@ public class TabbedAppMenuPropertiesDelegate extends AppMenuPropertiesDelegateIm
             if (MultiWindowUtils.getInstanceCount(PersistedInstanceType.ACTIVE)
                     >= MultiWindowUtils.getMaxInstances()) return false;
 
-            // On phones, show the menu only when in split-screen, with a single instance
-            // running on the foreground.
-            return isTabletSizeScreen()
-                    || (!mMultiWindowModeStateDispatcher.isChromeRunningInAdjacentWindow()
-                            && (mMultiWindowModeStateDispatcher.isInMultiWindowMode()
-                                    || mMultiWindowModeStateDispatcher.isInMultiDisplayMode()));
+            // mobile-bex: 上流はスマホだと「すでに分割画面に入っている」ときしか出さない
+            // (isTabletSizeScreen() || isInMultiWindowMode() ...)。しかしそれでは
+            // 分割画面にするために先に分割画面が要るという堂々巡りで、実質使えない。
+            // 画面サイズによらず出し、2つ目のウィンドウを開いてからタスクスイッチャーで
+            // 並べられるようにする。配信を見ながら別のページを開く用途で使う。
+            return true;
         } else {
             if (mMultiWindowModeStateDispatcher.isMultiInstanceRunning()) return false;
+            // mobile-bex: 153 では canEnterMultiWindowMode() が無くなった
+            // (MultiWindowUtils のパッケージ内部に移動)。この分岐はマルチインスタンス
+            // 非対応の古い端末用で、Android 12 以降は手前の分岐が true を返すため、
+            // ここは上流の条件のままでよい。
             return mMultiWindowModeStateDispatcher.isInMultiWindowMode()
                     || mMultiWindowModeStateDispatcher.isInMultiDisplayMode();
         }
