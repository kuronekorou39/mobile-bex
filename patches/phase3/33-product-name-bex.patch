# Patch 33: UI に出る「Chromium」表記を BEX にする
# 拡張機能をインストールしたときの見出しが「〜が Chromium に追加されました」で、
# アプリ名 (BEX) と食い違っていた。
#
# この文言は IDS_PRODUCT_NAME を参照しておらず "Chromium" が直接書かれている。
# grd を書き換えると翻訳 ID が変わって .xtb (翻訳済みリソース) にマッチしなく
# なるため、grd に書いた文言がそのまま表示される。Patch 27 (小窓表示) で使ったのと
# 同じ手口。
#
# 通知の許可を求める前に出るダイアログも「Chrome の通知で状況を簡単に把握」だった
# ので同様に直す (android_chrome_strings.grd)。通知そのものは動くので文言だけ。
#
# grd には "Chromium" が 595 箇所あるので、目に付いたものから個別に直す方針にする。
# 全部を機械的に置換すると、ライセンス表記のように「Chromium と名乗るのが正しい」
# 箇所まで変わってしまう。
diff --git a/chrome/app/chromium_strings.grd b/chrome/app/chromium_strings.grd
index 2e36329..2b325be 100644
--- a/chrome/app/chromium_strings.grd
+++ b/chrome/app/chromium_strings.grd
@@ -905,7 +905,7 @@ Chromium is unable to recover your settings.
       <if expr="enable_extensions_core">
         <!-- Extension installed bubble -->
         <message name="IDS_EXTENSION_INSTALLED_HEADING" desc="Title of the extension-installed bubble. Instructs that the extension was installed.">
-          <ph name="EXTENSION_NAME">$1<ex>Gmail Checker</ex></ph> has been added to Chromium
+          <ph name="EXTENSION_NAME">$1<ex>Gmail Checker</ex></ph> を BEX に追加しました
         </message>
 
         <!-- Extension uninstall prompt -->
diff --git a/chrome/browser/ui/android/strings/android_chrome_strings.grd b/chrome/browser/ui/android/strings/android_chrome_strings.grd
index 83a0c39..aa2c23f 100644
--- a/chrome/browser/ui/android/strings/android_chrome_strings.grd
+++ b/chrome/browser/ui/android/strings/android_chrome_strings.grd
@@ -2141,7 +2141,7 @@ Your Google account may have other forms of browsing history like searches and a
 
       <!-- About Chrome preferences -->
       <message name="IDS_PREFS_ABOUT_CHROME" desc="Title for the About Chrome page. [CHAR_LIMIT=32]">
-        About Chrome
+        BEX について
       </message>
       <message name="IDS_LEGAL_INFORMATION_SUMMARY" desc="Summary for legal information" meaning="Android">
         Copyright <ph name="year">%1$d<ex>2014</ex></ph> Google LLC. All rights reserved.
@@ -4317,6 +4317,24 @@ To change this setting, <ph name="BEGIN_LINK">BEGIN_LINK</ph>delete the Chrome d
       <message name="IDS_BEX_MENU_PIP" desc="Menu item that shrinks the browser into a small floating window (picture-in-picture), so the user can keep watching a stream while using other apps.">
         小窓表示
       </message>
+      <message name="IDS_BEX_CHECK_UPDATE_TITLE" desc="Settings entry that checks GitHub for a newer release of this browser.">
+        更新を確認
+      </message>
+      <message name="IDS_BEX_UPDATE_CHECKING" desc="Shown while the update check is in progress.">
+        確認中…
+      </message>
+      <message name="IDS_BEX_UPDATE_LATEST" desc="Shown when the running version is the newest published one.">
+        最新版です
+      </message>
+      <message name="IDS_BEX_UPDATE_AVAILABLE" desc="Shown when a newer version exists. The placeholder is a version number such as 0.1.7. Tapping opens the release page.">
+        <ph name="VERSION">%1$s<ex>0.1.7</ex></ph> が公開されています。タップで配布ページを開きます
+      </message>
+      <message name="IDS_BEX_UPDATE_FAILED" desc="Shown when the update check could not reach GitHub.">
+        確認できませんでした
+      </message>
+      <message name="IDS_BEX_SOURCE_CODE_TITLE" desc="Settings entry that opens the source repository of this browser.">
+        ソースコード
+      </message>
       <message name="IDS_MENU_EXTENSIONS" desc="Menu item for opening the 'Extensions' page that allows the user to manage installed extensions. [CHAR_LIMIT=27]">
         Extensions
       </message>
@@ -6531,7 +6549,7 @@ To change this setting, <ph name="BEGIN_LINK">BEGIN_LINK</ph>delete the Chrome d
 
       <!-- Notification Permission Rationale Dialog Strings-->
       <message name="IDS_NOTIFICATION_PERMISSION_RATIONALE_DIALOG_TITLE" desc="The title of a dialog shown to users before asking for notification permission.">
-        Chrome notifications make things easier
+        BEX の通知で状況を簡単に把握
       </message>
       <message name="IDS_NOTIFICATION_PERMISSION_RATIONALE_DIALOG_MESSAGE" desc="The body text of a dialog explaining the benefits of enabling Chrome notifications.">
         You’ll be able to easily manage media controls, Incognito sessions, downloads and more
