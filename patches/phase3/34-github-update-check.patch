+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.omaha;
+
+import android.content.SharedPreferences;
+import android.text.format.DateUtils;
+
+import org.json.JSONObject;
+
+import org.chromium.base.Log;
+import org.chromium.base.StreamUtil;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.net.ChromiumNetworkAdapter;
+import org.chromium.net.NetworkTrafficAnnotationTag;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * mobile-bex: GitHub のリリースを見て、新しい版が出ていないか調べる。
+ *
+ * <p>このブラウザは Play ストアではなく GitHub のリリースから配布する (サイドロード) ため、
+ * 上流の Omaha による更新確認は動かない。代わりにここで最新版を取得し、Omaha が使うのと
+ * 同じ場所 ({@link OmahaPrefUtils} の SharedPreferences) に書き込む。こうすると
+ * {@link VersionNumberGetter#isNewerVersionAvailable} 以降の判定と、三点メニューの
+ * 「更新」項目やツールバーのバッジといった既存の UI がそのまま使える。
+ *
+ * <p>APK を自分でダウンロードしてインストールする方式は採らない。それには
+ * REQUEST_INSTALL_PACKAGES 権限が要るが、これは「他のアプリを入れられる」強い権限で、
+ * ブラウザに持たせたくない。「更新」を押したらリリースページを開くところまでにする
+ * (docs/updates.md 参照)。
+ */
+@NullMarked
+public class BexUpdateChecker {
+    private static final String TAG = "BexUpdate";
+
+    private static final String LATEST_RELEASE_API =
+            "https://api.github.com/repos/kuronekorou39/mobile-bex/releases/latest";
+    private static final String RELEASES_PAGE =
+            "https://github.com/kuronekorou39/mobile-bex/releases/latest";
+
+    /** 最後に確認した時刻。GitHub API は未認証だと 60 req/hour/IP なので1日1回に抑える。 */
+    private static final String PREF_LAST_CHECK_MS = "bexLastUpdateCheckMs";
+
+    private static final long CHECK_INTERVAL_MS = DateUtils.DAY_IN_MILLIS;
+    private static final int TIMEOUT_MS = 10000;
+
+    private static final NetworkTrafficAnnotationTag TRAFFIC_ANNOTATION =
+            NetworkTrafficAnnotationTag.createComplete(
+                    "bex_github_update_check",
+                    """
+                    semantics {
+                      sender: "BEX Update Checker"
+                      description:
+                        "This browser is distributed as an APK on GitHub rather than through an "
+                        "app store, so it cannot be updated automatically. Once a day it asks the "
+                        "GitHub API for the latest published release and compares the version with "
+                        "the running one, so that the app menu can tell the user that a newer "
+                        "version exists."
+                      trigger: "Browser startup, at most once every 24 hours."
+                      data: "No user data. Only an unauthenticated GET for the release metadata."
+                      destination: WEBSITE
+                      internal {
+                        contacts {
+                          email: "kuronekorou39@gmail.com"
+                        }
+                      }
+                      user_data {
+                        type: NONE
+                      }
+                      last_reviewed: "2026-08-07"
+                    }
+                    policy {
+                      cookies_allowed: NO
+                      setting: "This feature can not be disabled."
+                      policy_exception_justification: "Not implemented."
+                    }
+                    """);
+
+    private BexUpdateChecker() {}
+
+    /** 前回の確認から十分たっていれば、バックグラウンドで最新版を調べる。 */
+    public static void maybeCheck() {
+        PostTask.postTask(TaskTraits.BEST_EFFORT_MAY_BLOCK, BexUpdateChecker::checkIfDue);
+    }
+
+    private static void checkIfDue() {
+        SharedPreferences prefs = OmahaPrefUtils.getSharedPreferences();
+        long now = System.currentTimeMillis();
+        long last = prefs.getLong(PREF_LAST_CHECK_MS, 0);
+
+        // 端末の時計が巻き戻された場合 (now < last) も確認しに行く。
+        if (last != 0 && now >= last && now - last < CHECK_INTERVAL_MS) return;
+
+        // 通信に失敗しても時刻は進めておく。繋がらないたびに起動のたび叩きに行くより、
+        // 1日待って諦める方がよい。
+        prefs.edit().putLong(PREF_LAST_CHECK_MS, now).apply();
+
+        String version = fetchLatestVersion();
+        if (version == null) return;
+
+        prefs.edit()
+                .putString(OmahaPrefUtils.PREF_LATEST_VERSION, version)
+                .putString(OmahaPrefUtils.PREF_MARKET_URL, RELEASES_PAGE)
+                .apply();
+        Log.i(TAG, "Latest release on GitHub: %s", version);
+    }
+
+    /**
+     * @return リリースの版数 (タグの先頭の "v" を除いたもの)。取れなければ null。
+     */
+    private static @org.chromium.build.annotations.Nullable String fetchLatestVersion() {
+        HttpURLConnection connection = null;
+        BufferedReader reader = null;
+        try {
+            connection =
+                    (HttpURLConnection)
+                            ChromiumNetworkAdapter.openConnection(
+                                    new URL(LATEST_RELEASE_API), TRAFFIC_ANNOTATION);
+            connection.setConnectTimeout(TIMEOUT_MS);
+            connection.setReadTimeout(TIMEOUT_MS);
+            connection.setRequestProperty("Accept", "application/vnd.github+json");
+
+            if (connection.getResponseCode() != HttpURLConnection.HTTP_OK) {
+                Log.w(TAG, "Update check failed: HTTP %d", connection.getResponseCode());
+                return null;
+            }
+
+            reader =
+                    new BufferedReader(
+                            new InputStreamReader(
+                                    connection.getInputStream(), StandardCharsets.UTF_8));
+            StringBuilder body = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) {
+                body.append(line);
+            }
+
+            String tag = new JSONObject(body.toString()).optString("tag_name");
+            if (tag.isEmpty()) return null;
+            return tag.startsWith("v") ? tag.substring(1) : tag;
+        } catch (Exception e) {
+            // 通信もパースも失敗しうる。更新確認が失敗してもブラウザの動作には影響しない。
+            Log.w(TAG, "Update check failed", e);
+            return null;
+        } finally {
+            StreamUtil.closeQuietly(reader);
+            if (connection != null) connection.disconnect();
+        }
+    }
+}
