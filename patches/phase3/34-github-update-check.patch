+    /**
+     * mobile-bex: 「更新を確認」と「ソースコード」を設定する。
+     *
+     * <p>確認中も結果もその場の文字を書き換えるだけにして、ダイアログや画面遷移で操作を
+     * 遮らない。更新が見つかったときだけ、押せば配布ページを開く。
+     */
+    private void setUpBexPreferences() {
+        Preference update = findPreference(PREF_BEX_CHECK_UPDATE);
+        assumeNonNull(update);
+        update.setOnPreferenceClickListener(
+                pref -> {
+                    if (mBexUpdateCheckRunning) return true;
+                    mBexUpdateCheckRunning = true;
+                    pref.setSummary(getString(R.string.bex_update_checking));
+                    BexUpdateChecker.checkNow(
+                            latestVersion -> {
+                                mBexUpdateCheckRunning = false;
+                                // 確認中に設定画面を閉じられていることがある。
+                                if (!isAdded()) return;
+                                onBexUpdateChecked(pref, latestVersion);
+                            });
+                    return true;
+                });
+
+        Preference source = findPreference(PREF_BEX_SOURCE_CODE);
+        assumeNonNull(source);
+        source.setSummary(BexUpdateChecker.getRepositoryUrl());
+        source.setOnPreferenceClickListener(
+                pref -> {
+                    openUrlInNewTab(BexUpdateChecker.getRepositoryUrl());
+                    return true;
+                });
+    }
+
+    private void onBexUpdateChecked(Preference pref, @Nullable String latestVersion) {
+        if (latestVersion == null) {
+            pref.setSummary(getString(R.string.bex_update_failed));
+            pref.setOnPreferenceClickListener(null);
+            setUpBexPreferences();
+            return;
+        }
+
+        VersionNumber current = VersionNumber.fromString(VersionInfo.getProductVersion());
+        VersionNumber latest = VersionNumber.fromString(latestVersion);
+        if (current != null && latest != null && current.isSmallerThan(latest)) {
+            pref.setSummary(getString(R.string.bex_update_available, latestVersion));
+            pref.setOnPreferenceClickListener(
+                    p -> {
+                        openUrlInNewTab(BexUpdateChecker.getReleasesPageUrl());
+                        return true;
+                    });
+        } else {
+            pref.setSummary(getString(R.string.bex_update_latest));
+            setUpBexPreferences();
+        }
+    }
+
+    private void openUrlInNewTab(String url) {
+        Context context = getActivity();
+        if (context == null) return;
+        Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
+        // 自分で開く。外部ブラウザに渡す意味がない。
+        intent.setPackage(context.getPackageName());
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        context.startActivity(intent);
     }
 
