index 0000000..881e945
--- /dev/null
+++ b/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/BexExtensionShortcutsImpl.java
@@ -0,0 +1,252 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.extensions;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.content.pm.ShortcutInfo;
+import android.content.pm.ShortcutManager;
+import android.graphics.Bitmap;
+import android.graphics.drawable.Icon;
+
+import org.chromium.base.Callback;
+import org.chromium.base.Log;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.Initializer;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.build.annotations.ServiceImpl;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.ui.browser_window.ChromeAndroidTask;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/** The implementation of {@link BexExtensionShortcuts}. */
+@NullMarked
+@ServiceImpl(BexExtensionShortcuts.class)
+public class BexExtensionShortcutsImpl
+        implements BexExtensionShortcuts, ExtensionActionsBridge.Observer {
+    private static final String TAG = "BexExtShortcuts";
+
+    private static final String SHORTCUT_ID_PREFIX = "bex-extension-";
+
+    /**
+     * Side of the icon we ask for, in DIP.
+     *
+     * <p>Launchers draw shortcut icons at roughly the size of an app icon, so this is asking for
+     * more than the toolbar does. Extension icons are at most 128px, so there is no point going
+     * higher.
+     */
+    private static final int ICON_SIZE_DP = 48;
+
+    private @Nullable Activity mActivity;
+    private @Nullable ExtensionActionsBridge mBridge;
+    private @Nullable Callback<String> mRunner;
+
+    /** The extension a shortcut asked for, held until the extension system has loaded. */
+    private @Nullable String mPendingActionId;
+
+    /** Set while an update is already posted, so a burst of icon updates publishes once. */
+    private boolean mUpdateScheduled;
+
+    private boolean mDestroyed;
+
+    public BexExtensionShortcutsImpl() {}
+
+    @Override
+    @Initializer
+    public void initialize(
+            Activity activity, ChromeAndroidTask task, Profile profile, Callback<String> runner) {
+        mActivity = activity;
+        mRunner = runner;
+        mBridge = new ExtensionActionsBridge(task, profile);
+        mBridge.addObserver(this);
+        scheduleUpdate();
+    }
+
+    @Override
+    public void destroy() {
+        mDestroyed = true;
+        if (mBridge != null) {
+            mBridge.removeObserver(this);
+            mBridge.destroy();
+            mBridge = null;
+        }
+        mActivity = null;
+        mRunner = null;
+    }
+
+    @Override
+    public void handleIntent(@Nullable Intent intent) {
+        if (intent == null) return;
+        String actionId = intent.getStringExtra(EXTRA_EXTENSION_ID);
+        if (actionId == null || actionId.isEmpty()) return;
+
+        // Consume it. Otherwise the extension would run again every time the activity is recreated
+        // from the same intent, e.g. on rotation.
+        intent.removeExtra(EXTRA_EXTENSION_ID);
+
+        mPendingActionId = actionId;
+        maybeRunPending();
+    }
+
+    // ExtensionActionsBridge.Observer
+
+    @Override
+    public void onActionModelInitialized() {
+        maybeRunPending();
+        scheduleUpdate();
+    }
+
+    @Override
+    public void onActionAdded(String actionId) {
+        scheduleUpdate();
+    }
+
+    @Override
+    public void onActionRemoved(String actionId) {
+        scheduleUpdate();
+    }
+
+    @Override
+    public void onActionUpdated(String actionId) {
+        scheduleUpdate();
+    }
+
+    @Override
+    public void onActionIconUpdated(String actionId) {
+        // Icons load asynchronously, so the first publish carries blank ones. This is what fills
+        // them in.
+        scheduleUpdate();
+    }
+
+    @Override
+    public void onPinnedActionsChanged() {
+        // Shortcuts list every extension, so pinning does not affect them.
+    }
+
+    private void maybeRunPending() {
+        if (mPendingActionId == null || mBridge == null || mRunner == null) return;
+        // Running an action needs the extension system loaded. If it is not yet, the pending id is
+        // kept and this runs again from onActionModelInitialized().
+        if (!mBridge.areActionsInitialized()) return;
+
+        String actionId = mPendingActionId;
+        mPendingActionId = null;
+        mRunner.onResult(actionId);
+    }
+
+    private void scheduleUpdate() {
+        if (mUpdateScheduled || mDestroyed) return;
+        mUpdateScheduled = true;
+        PostTask.postTask(
+                TaskTraits.UI_BEST_EFFORT,
+                () -> {
+                    mUpdateScheduled = false;
+                    update();
+                });
+    }
+
+    private void update() {
+        if (mDestroyed || mActivity == null || mBridge == null) return;
+        if (!mBridge.areActionsInitialized()) return;
+
+        Activity activity = mActivity;
+        ShortcutManager manager = activity.getSystemService(ShortcutManager.class);
+        if (manager == null) return;
+
+        try {
+            // Build one shortcut per installed extension, then reconcile with what is published.
+            List<ShortcutInfo> shortcuts = buildShortcuts();
+            Set<String> live = new HashSet<>();
+            for (ShortcutInfo shortcut : shortcuts) {
+                live.add(shortcut.getId());
+            }
+
+            // A shortcut of ours whose extension is gone. The dynamic ones can just be dropped,
+            // but a copy the user dragged onto the home screen stays there forever unless we say
+            // something: it would open the browser and do nothing at all. Disabling it makes the
+            // launcher explain why instead.
+            List<String> gone = new ArrayList<>();
+            collectOursNotIn(manager.getDynamicShortcuts(), live, gone);
+            collectOursNotIn(manager.getPinnedShortcuts(), live, gone);
+
+            if (!gone.isEmpty()) {
+                manager.disableShortcuts(
+                        gone, activity.getString(R.string.bex_shortcut_extension_gone));
+                manager.removeDynamicShortcuts(gone);
+            }
+            // Ours are not the only shortcuts: the browser ships "New tab" as a manifest one and
+            // publishes "New Incognito tab" dynamically. So never call setDynamicShortcuts(),
+            // which would drop the latter; touch only what is ours.
+            manager.addDynamicShortcuts(shortcuts);
+            // Neither of the above touches copies already on the home screen. This is what
+            // refreshes those, and re-enables any whose extension was reinstalled.
+            manager.enableShortcuts(new ArrayList<>(live));
+            manager.updateShortcuts(shortcuts);
+        } catch (IllegalStateException | IllegalArgumentException e) {
+            // Some launchers refuse to publish. The shortcuts are then simply absent, which does
+            // not affect the browser itself.
+            Log.w(TAG, "Could not publish extension shortcuts", e);
+        }
+    }
+
+    /** Adds the ids of our shortcuts in {@code published} that are missing from {@code live}. */
+    private static void collectOursNotIn(
+            List<ShortcutInfo> published, Set<String> live, List<String> out) {
+        for (ShortcutInfo shortcut : published) {
+            String id = shortcut.getId();
+            if (id.startsWith(SHORTCUT_ID_PREFIX) && !live.contains(id) && !out.contains(id)) {
+                out.add(id);
+            }
+        }
+    }
+
+    private List<ShortcutInfo> buildShortcuts() {
+        assert mActivity != null;
+        assert mBridge != null;
+
+        List<ShortcutInfo> shortcuts = new ArrayList<>();
+        float density = mActivity.getResources().getDisplayMetrics().density;
+
+        for (String actionId : mBridge.getActionIds()) {
+            // Ask about no tab in particular: a shortcut is not tied to one.
+            ExtensionAction action = mBridge.getAction(actionId, Tab.INVALID_TAB_ID);
+            if (action == null) continue;
+            String title = action.getTitle();
+            if (title.isEmpty()) continue;
+
+            Intent intent = new Intent(Intent.ACTION_MAIN);
+            intent.setPackage(mActivity.getPackageName());
+            intent.putExtra(EXTRA_EXTENSION_ID, actionId);
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+
+            ShortcutInfo.Builder builder =
+                    new ShortcutInfo.Builder(mActivity, SHORTCUT_ID_PREFIX + actionId)
+                            .setShortLabel(title)
+                            .setLongLabel(title)
+                            .setIntent(intent);
+
+            Bitmap icon =
+                    mBridge.getActionIcon(
+                            actionId,
+                            Tab.INVALID_TAB_ID,
+                            /* webContents= */ null,
+                            ICON_SIZE_DP,
+                            ICON_SIZE_DP,
+                            density);
+            if (icon != null) {
+                builder.setIcon(Icon.createWithBitmap(icon));
+            }
+            shortcuts.add(builder.build());
+        }
+        return shortcuts;
