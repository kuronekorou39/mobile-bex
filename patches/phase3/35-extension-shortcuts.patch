+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui.extensions;
+
+import android.app.Activity;
+import android.content.Intent;
+
+import org.chromium.base.Callback;
+import org.chromium.base.ServiceLoaderUtil;
+import org.chromium.base.lifetime.Destroyable;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.ui.browser_window.ChromeAndroidTask;
+
+/**
+ * mobile-bex: Publishes the installed extensions as launcher shortcuts.
+ *
+ * <p>Long-pressing the BEX icon lists the extensions, and each of them can be dragged onto the home
+ * screen. Tapping one starts the browser and runs that extension, so an extension can be used much
+ * like an app.
+ *
+ * <p>This interface is always compiled, while the implementation is only compiled when the
+ * extension system is. Go through {@link #maybeCreate} rather than naming the implementation.
+ */
+@NullMarked
+public interface BexExtensionShortcuts extends Destroyable {
+    /**
+     * The extension to run, carried by the shortcut's intent.
+     *
+     * <p>Read by the browser process only. The intent is pinned by the launcher but is restricted
+     * to this package by {@link Intent#setPackage}, so it does not let other apps run extensions.
+     * Exposing chrome-extension:// through an intent-filter was considered and rejected: that would
+     * let any app open an extension's pages.
+     */
+    String EXTRA_EXTENSION_ID = "org.chromium.chrome.browser.ui.extensions.EXTENSION_ID";
+
+    /**
+     * Instantiates the implementation if it is available.
+     *
+     * @param runner Runs the extension with the given id. Called on the UI thread, and only once
+     *     the extension system has finished loading.
+     */
+    static @Nullable BexExtensionShortcuts maybeCreate(
+            Activity activity, ChromeAndroidTask task, Profile profile, Callback<String> runner) {
+        // Check that the extension UI is enabled first, as the toolbar does.
+        if (!ExtensionUi.isEnabled(profile)) {
+            return null;
+        }
+
+        BexExtensionShortcuts shortcuts =
+                ServiceLoaderUtil.maybeCreate(BexExtensionShortcuts.class);
+        if (shortcuts == null) {
+            return null;
+        }
+        shortcuts.initialize(activity, task, profile, runner);
+        return shortcuts;
+    }
+
+    /** Must be called exactly once, by {@link #maybeCreate}. */
+    void initialize(
+            Activity activity, ChromeAndroidTask task, Profile profile, Callback<String> runner);
+
+    /**
+     * Runs the extension named by the intent, if it names one.
+     *
+     * <p>Call this for both the launch intent and any later intent delivered to the running
+     * browser. The extension may be run asynchronously, once the extension system has loaded.
+     */
+    void handleIntent(@Nullable Intent intent);
+}
