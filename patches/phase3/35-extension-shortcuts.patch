         // 結果は Omaha と同じ保存先に書かれ、三点メニューの「更新」項目に反映される。
         BexUpdateChecker.maybeCheck();
 
+        // mobile-bex: 拡張機能をランチャーのショートカットとして出す。BEX のアイコンを
+        // 長押しすると並び、ホーム画面に置ける。併せて、そのショートカットから起動された
+        // 場合はここで拡張機能を実行する。この時点なら拡張機能の読み込みが済んでいる。
+        ChromeAndroidTask task = mChromeAndroidTaskSupplier.get();
+        if (task != null) {
+            BexExtensionShortcuts.maybeRunFromIntent(
+                    mActivity.getIntent(), task, originalProfile);
+            BexExtensionShortcuts.updateSoon(mActivity, task, originalProfile);
+        }
+
         initMerchantTrustSignals(originalProfile);
     }
 
