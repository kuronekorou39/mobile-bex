# Patch 39: 他アプリからのリンクで Custom Tab が起動できない (繰り返し終了) のを直す
# メールや X のアプリでリンクを踏むと、既定ブラウザの BEX が Custom Tab
# (CustomTabActivity) で開こうとして、毎回クラッシュしていた。端末の dropbox には
# 同じ記録が 28 件残っていた:
#   Unable to start activity CustomTabActivity
#   Caused by: NullPointerException: View.getContext() on a null object reference
#     at OmniboxChipManager.<init>
#     at RootUiCoordinator.initializeToolbar
#
# 原因は Patch 29。OpenInAppUtils#isOpenInAppAvailable をスマホでも true にしたため、
# RootUiCoordinator#initializeToolbar が「アプリで開く」チップの置き場
# (R.id.omnibox_chip_container) を探して OmniboxChipManager を作るようになった。
# この View は通常タブの location_bar.xml にしか無く、Custom Tab のツールバーでは
# findViewById が null を返す。上流では DeviceInfo.isDesktop() な端末しか通らない道で、
# 上流もその後チップの生成を TabbedRootUiCoordinator に移して同じ落とし穴を避けている。
#
# 置き場が無ければチップを作らない、という最小の修正にした。Custom Tab での
# 「アプリで開く」はメニュー (CustomTabOpenInAppEntryPoint) で提供されるので機能は
# 損なわれない。通常タブでは従来どおりチップが出る。
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ui/RootUiCoordinator.java b/chrome/android/java/src/org/chromium/chrome/browser/ui/RootUiCoordinator.java
index a9aaa10..2f76eb1 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ui/RootUiCoordinator.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ui/RootUiCoordinator.java
@@ -1874,7 +1874,15 @@ public class RootUiCoordinator
             if (OpenInAppUtils.isOpenInAppAvailable()) {
                 ViewGroup omniboxChipContainer =
                         controlContainer.findViewById(R.id.omnibox_chip_container);
-                mOmniboxChipManager = new OmniboxChipManager(omniboxChipContainer);
+                // mobile-bex: この View は通常タブの location_bar.xml にしか無い。Custom Tab
+                // (他アプリから開いたリンク) のツールバーには無いので、ここで null を渡すと
+                // OmniboxChipManager のコンストラクタで落ちて「繰り返し終了」になる。
+                // 上流はチップの生成を TabbedRootUiCoordinator に移して同じ問題を避けている。
+                // Custom Tab では「アプリで開く」はメニュー (CustomTabOpenInAppEntryPoint) だけで
+                // 足りるので、チップは作らない。
+                if (omniboxChipContainer != null) {
+                    mOmniboxChipManager = new OmniboxChipManager(omniboxChipContainer);
+                }
             }
 
             mToolbarManager =
