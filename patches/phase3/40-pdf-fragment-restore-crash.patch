# Patch 40: PDF を開いたタブがあると、ブラウザを再起動できなくなるのを直す
# PDF のタブを開いたままバックグラウンドに回し、後で戻る (Activity の再生成) と
# 起動できずに落ちていた。dropbox の記録:
#   Unable to start activity ChromeTabbedActivity
#   Caused by: Fragment$InstantiationException: Unable to instantiate fragment
#     PdfCoordinator$ChromePdfViewerFragment: could not find Fragment constructor
#   Caused by: NoSuchMethodException: ChromePdfViewerFragment.<init> []
#
# FragmentManager は Activity の状態復元時に、保存されていた Fragment を引数なしの
# コンストラクタで作り直す。ChromePdfViewerFragment には委譲先を受け取る
# コンストラクタしか無く、復元の時点で例外になる。上流のバグで、上流 main では
# 引数なしコンストラクタが追加されている (その後さらに Fragment の再利用まで
# 実装されているが、こちらは最小限に留める)。
#
# 引数なしコンストラクタを足し、委譲先が無い間のリンククリックは無視する。
# 復元された Fragment は PdfCoordinator のコンストラクタが既にタグ (tabId) で
# 見つけて捨て、新しい Fragment を作り直す作りになっているので、それ以上は要らない。
# proguard (chrome/android/proguard/main.flags) は Fragment 派生の引数なし
# コンストラクタを keep するので、リリースビルドでも残る。
diff --git a/chrome/browser/ui/android/pdf/java/src/org/chromium/chrome/browser/pdf/PdfCoordinator.java b/chrome/browser/ui/android/pdf/java/src/org/chromium/chrome/browser/pdf/PdfCoordinator.java
index fdfc676..489ec8c 100644
--- a/chrome/browser/ui/android/pdf/java/src/org/chromium/chrome/browser/pdf/PdfCoordinator.java
+++ b/chrome/browser/ui/android/pdf/java/src/org/chromium/chrome/browser/pdf/PdfCoordinator.java
@@ -153,7 +153,16 @@ public class PdfCoordinator implements PdfActionsDelegate {
     /** The class responsible for rendering pdf document. */
     public static class ChromePdfViewerFragment extends PdfViewerFragment {
 
-        private final PdfActionsDelegate mDelegate;
+        private @Nullable PdfActionsDelegate mDelegate;
+
+        /**
+         * mobile-bex: FragmentManager が Activity の状態復元でこの Fragment を作り直すときに
+         * 使う引数なしコンストラクタ。これが無いと、PDF を開いたタブがある状態で
+         * ChromeTabbedActivity が再生成される (バックグラウンドから戻る等) たびに
+         * Fragment$InstantiationException で起動できなくなる。復元された Fragment 自体は
+         * PdfCoordinator のコンストラクタがタグ (tabId) で見つけて捨て、新しく作り直す。
+         */
+        public ChromePdfViewerFragment() {}
 
         public ChromePdfViewerFragment(PdfActionsDelegate handler) {
             mDelegate = handler;
@@ -170,6 +179,7 @@ public class PdfCoordinator implements PdfActionsDelegate {
 
         @Override
         public boolean onLinkClicked(ExternalLink externalLink) {
+            if (mDelegate == null) return false;
             return mDelegate.onLinkClicked(externalLink.getUri());
         }
 
