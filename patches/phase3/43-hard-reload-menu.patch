             enterPictureInPictureFromMenu();
             RecordUserAction.record("MobileMenuBexPip");
+        } else if (id == R.id.bex_hard_reload_menu_id) {
+            // mobile-bex: PC の Ctrl+Shift+R と同じ、キャッシュを無視した再読み込み。
+            // キーボードでは上流も対応済み (KeyboardShortcuts の RELOAD_TAB_BYPASSING_CACHE)
+            // だが、タッチからの入口が無かった。
+            if (currentTab != null) {
+                currentTab.reloadIgnoringCache();
+                RecordUserAction.record("MobileMenuBexHardReload");
+            }
         } else if (id == R.id.extensions_menu_id) {
             LoadUrlParams params =
                     new LoadUrlParams(
