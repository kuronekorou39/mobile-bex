+    private boolean isSidePanelOverlay(@Px int windowWidth, @Px int minWebContentsWidth) {
+        return windowWidth - minWebContentsWidth
+                < ViewUtils.dpToPx(mParentActivity, SIDE_PANEL_OVERLAY_BELOW_AVAILABLE_WIDTH_DP);
+    }
