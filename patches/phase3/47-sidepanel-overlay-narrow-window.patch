+     * あいだはサイドパネルの幅を 0 に見せて、ページを縮めさせない。
+     */
+    private SideUiSpecs toObserverSpecs(SideUiSpecs specs) {
+        var sidePanel = getSideUiContainerById(SideUiId.SIDE_PANEL);
+        if (sidePanel == null || !isSidePanelOverlay()) return specs;
+
+        Map<@AnchorSide Integer, SideUiSize> observerSpecs = new ArrayMap<>();
+        for (Map.Entry<@AnchorSide Integer, SideUiSize> entry : specs.entrySet()) {
+            boolean isSidePanelSide = entry.getKey() == sidePanel.getAnchorSide();
+            observerSpecs.put(
+                    entry.getKey(),
+                    isSidePanelSide
+                            ? new SideUiSize(0, HeightType.NOT_APPLICABLE)
+                            : entry.getValue());
+        }
+        return new SideUiSpecs(observerSpecs);
+    }
