# Addition to chrome/browser/ui/android/extensions/BUILD.gn
# Insert after the existing android_library("java") block, inside the file scope.
#
# if (enable_extensions_core) {
#   robolectric_binary("extensions_bottomsheet_junit_tests") { ... }
# }

if (enable_extensions_core) {
  robolectric_binary("extensions_bottomsheet_junit_tests") {
    sources = [
      "junit/src/org/chromium/chrome/browser/ui/extensions/ExtensionBottomSheetContentTest.java",
      "junit/src/org/chromium/chrome/browser/ui/extensions/ExtensionBottomSheetCoordinatorTest.java",
    ]
    deps = [
      ":java",
      "//base:base_java",
      "//base:base_java_test_support",
      "//components/browser_ui/bottomsheet/android:java",
      "//components/thin_webview:java",
      "//content/public/android:content_full_java",
      "//third_party/android_deps:robolectric_all_java",
      "//third_party/junit:junit",
      "//third_party/mockito:mockito_java",
      "//ui/android:ui_full_java",
    ]
  }
}
